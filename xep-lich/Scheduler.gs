function buildAdvice(days, stores, plan, gaps, ext, byMa, caMap, S, N){
  // thiếu gộp theo cơ sở / ca / vị trí
  var agg={}; gaps.forEach(function(g){ var k=g.MaCS+'|'+g.Khoi+'|'+g.ViTri+'|'+(g.Muc||'thieu'); agg[k]=agg[k]||{MaCS:g.MaCS,Khoi:g.Khoi,ViTri:g.ViTri,Muc:g.Muc||'thieu',ngay:0,tong:0}; agg[k].ngay++; agg[k].tong+=g.Thieu; });
  var gapSummary=Object.keys(agg).map(function(k){return agg[k];}).sort(function(a,b){return b.tong-a.tong;});
  var tuyen=gapSummary.filter(function(g){return g.ngay>=3 && g.Muc==='thieu';}).map(function(g){ return 'Thiếu '+Math.ceil(g.tong/g.ngay)+' '+g.ViTri.toLowerCase()+' ca '+g.Khoi.toLowerCase()+' tại '+g.MaCS+' ('+g.ngay+'/7 ngày): chủ quán hỗ trợ hoặc đưa thử việc vào, cần tuyển thêm'; });
  var gioTuan=Object.keys(S).map(function(m){ var n=byMa[m]; if(!n) return null; var st=S[m]; var main=Object.keys(st.storeHours).sort(function(a,b){return st.storeHours[b]-st.storeHours[a];})[0]||'';
    return {MaNV:m,Ten:n.Ten,Loai:n.Loai,Gio:Math.round(st.hours*10)/10,Ngay:Object.keys(st.days).length,CoSo:main}; }).filter(function(x){return x && x.Gio>0;}).sort(function(a,b){return b.Gio-a.Gio;});
  var coSo=stores.map(function(cs){ var hrs=0, ppl={}; plan.forEach(function(a){ if(a.MaCS===cs.MaCS){ hrs+=(+caMap[a.MaCa].SoGio||0); ppl[a.MaNV]=1; } });
    return {MaCS:cs.MaCS,Ten:cs.TenCS,GioNgay:Math.round(hrs/7*10)/10,SoNguoi:Object.keys(ppl).length,GioTrenTrieu:(+cs.DoanhThuTB)?Math.round(hrs/7/(+cs.DoanhThuTB)*10)/10:''}; });
  return {gapSummary:gapSummary, tuyen:tuyen, gioTuan:gioTuan, coSo:coSo};
}

