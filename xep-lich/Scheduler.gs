  var ma='TD'+a.replace(':','')+'-'+b.replace(':',''); if(!rows('Ca').some(function(x){ return x.MaCa===ma; })){ var sh=SS.getSheetByName('Ca'), h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0];
    sh.appendRow(h.map(function(k){ return {MaCa:ma,TenCa:'Giờ tự do '+a+'–'+b,GioBD:a,GioKT:b,SoGio:Math.round((toMin(b)-toMin(a))/60*100)/100,LoaiNV:'',CoSo:'ALL'}[k]; })); }
  return {ok:true, maCa:ma}; }
