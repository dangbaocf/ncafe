  var r=docLichQuan_(monday, tenTab, luoi), list=rows('NhanVien').filter(function(n){ return n.TrangThai!=='Đã nghỉ'; }), byMa={}; list.forEach(function(n){ byMa[up(n.MaNV)]=n; });
  var days=[]; for(var i=0;i<7;i++) days.push(fmtDate(addDays(new Date(monday+'T12:00:00+07:00'),i)));
  var la={}, can=[], ds=[], hoTro=[];
  r.o.forEach(function(e){ if(e.support){ hoTro.push(e); return; } if(e.lo){ can.push({ngay:e.ngay, cs:e.cs, o:e.raw, lo:e.lo, vitri:e.tab+' ô '+String.fromCharCode(64+e.cot)+e.hang}); if(!e.ten || e.bd==null) return; }
    var n=findNV(e.ten, e.cs, list) || timTenLien_(e.ten, e.cs, list); if(!n){ var k=e.ten; la[k]=la[k]||{ten:e.ten, so:0, vd:e.tab+' ô '+String.fromCharCode(64+e.cot)+e.hang}; la[k].so++; return; }
    e.ma=up(n.MaNV); ds.push(e); });
  var g=lichGopNguoi_(ds); g.lo.forEach(function(x){ can.push({ngay:x.ngay, cs:'', o:x.ten, lo:x.lo, vitri:''}); });
  var off={}; r.off.forEach(function(x){ var n=findNV(x.ten,'',list); if(n) off[up(n.MaNV)+'|'+x.ngay]=1; });
  // nhân sự cố định không có tên trong lịch tuần → thêm ca quen (4 tuần gần nhất)
  var coTen={}, them=[]; g.ca.forEach(function(c){ coTen[c.ma]=1; });
  list.filter(laCoDinh_).forEach(function(n){ var ma=up(n.MaNV); if(coTen[ma]) return; caQuenCoDinh_(ma, monday).forEach(function(q){ var d=days.filter(function(x){ return dowOf(x)===q.thu; })[0]; if(!d || off[ma+'|'+d]) return;
      var c=rows('Ca').filter(function(x){ return x.MaCa===q.MaCa; })[0]; if(!c) return; them.push({ngay:d, cs:q.MaCS, ma:ma, ten:tenNgan(n), bd:toMin(c.GioBD), kt:toMin(c.GioKT), vitri:q.ViTri, coDinh:true}); }); });
  var ca=g.ca.map(function(c){ var n=byMa[c.ma], vt=c.ben==='PC'?'Pha chế':(c.ben==='PV'?(n&&(n.ViTri==='Bảo vệ'||n.ViTri==='Rửa ly')?n.ViTri:'Phục vụ'):((n&&n.ViTri)||'Phục vụ'));
      if(vt==='Quản lý'||vt==='Thu ngân') vt='Pha chế'; return {ngay:c.ngay, cs:c.cs, ma:c.ma, ten:n?tenNgan(n):c.ten, bd:c.bd, kt:c.kt, vitri:vt, gay:c.gay, tc:c.tc, raw:c.raw}; })
    .concat(them.map(function(t){ return {ngay:t.ngay, cs:t.cs, ma:t.ma, ten:t.ten, bd:t.bd, kt:t.kt, vitri:t.vitri, raw:'(cố định – tự thêm)', coDinh:true}; }));
  ca.forEach(function(c){ if(off[c.ma+'|'+c.ngay]) can.push({ngay:c.ngay, cs:c.cs, o:c.ten, lo:'Vừa có ca vừa ghi OFF', vitri:''}); });
  // đếm người & người biết pha chế từng quán / ngày / buổi; so định mức
  var KH={'Sáng':[390,720],'Trưa':[720,1020],'Tối':[1020,1350]}, dem={}, thieu=[], thieuPC=[];
  ca.concat(hoTro.map(function(e){ return {cs:e.cs, ngay:e.ngay, ma:'HT:'+e.ten, bd:e.bd, kt:e.kt, vitri:'Pha chế'}; })).forEach(function(c){ Object.keys(KH).forEach(function(k){ var a=KH[k][0], b=KH[k][1]; if(c.bd!=null && Math.min(c.kt,b)-Math.max(c.bd,a)>=60){ var key=c.cs+'|'+c.ngay+'|'+k; var x=dem[key]=dem[key]||{tong:{},pc:{}}; x.tong[c.ma]=1; if(c.vitri==='Pha chế'||laBietPC_(byMa[c.ma])) x.pc[c.ma]=1; } }); });   // người nhà hỗ trợ: có mặt + đứng quầy
  var CS=['TP','DD','TD','TNV','LDD'], bang=[], DMX=dmHienTai_();
  CS.forEach(function(cs){ days.forEach(function(d){ var loai=(dowOf(d)===0||dowOf(d)===6)?'CT':'NT'; Object.keys(KH).forEach(function(k){
    var dm=DMX[cs+'|'+k+'|'+loai]; if(!dm) return; var x=dem[cs+'|'+d+'|'+k]||{tong:{},pc:{}}, t=Object.keys(x.tong).length, p=Object.keys(x.pc).length;
    bang.push({cs:cs, ngay:d, khoi:k, tong:t, pc:p, tongMin:dm.tong[0], tongChuan:dm.tong[1], pcMin:dm.pc[0], pcChuan:dm.pc[1]});
    if(p<1) thieuPC.push({cs:cs, ngay:d, khoi:k, pc:p, can:Math.max(1,dm.pc[0])}); else if(p<dm.pc[0]) thieu.push({cs:cs, ngay:d, khoi:k, loai:'pha chế', co:p, can:dm.pc[0]});
    if(t<dm.tong[0]) thieu.push({cs:cs, ngay:d, khoi:k, loai:'người', co:t, can:dm.tong[0]}); }); }); });
  var nguoi={}; ca.forEach(function(c){ nguoi[c.ma]=1; });
  return {ok:true, tuan:monday, days:days, nguon:r.nguon, loi:r.loi, ca:ca, soCa:ca.length, soNguoi:Object.keys(nguoi).length, coDinh:them.length,
    tenLa:Object.keys(la).map(function(k){ return la[k]; }), canXem:can, thieuPC:thieuPC, thieu:thieu, bang:bang}; }
function lichPhienBanSh_(){ var sh=SS.getSheetByName('LichPhienBan'); if(!sh){ sh=SS.insertSheet('LichPhienBan'); sh.getRange(1,1,1,LICH_PB_COT.length).setValues([LICH_PB_COT]); } return sh; }
function lichTuanHienTai_(monday){ var days=[]; for(var i=0;i<7;i++) days.push(fmtDate(addDays(new Date(monday+'T12:00:00+07:00'),i)));
  return rows('LichLam').filter(function(l){ return days.indexOf(dateKey(l.Ngay))>-1; }).map(function(l){ return [dateKey(l.Ngay), l.MaCS, String(l.MaNV), l.MaCa, l.ViTri, l.GhiChu||'']; }); }
function luuPhienBan_(monday, boi, nguon, ghiChu, dong){ var sh=lichPhienBanSh_(), cu=rows('LichPhienBan').filter(function(r){ return dateKey(r.Tuan)===monday; }), so=cu.length?Math.max.apply(null,cu.map(function(r){ return +r.So||0; }))+1:1;
  sh.appendRow([monday, so, new Date(), boi, nguon, String(ghiChu||'').slice(0,300), dong.length, JSON.stringify(dong)]); return so; }
function ghiLichTuan_(monday, dong){ var days=[]; for(var i=0;i<7;i++) days.push(fmtDate(addDays(new Date(monday+'T12:00:00+07:00'),i)));
  var sh=SS.getSheetByName('LichLam'), all=sh.getDataRange().getValues(), h=all.shift(), w=Math.max(6,h.length);
  var giu=all.filter(function(r){ return r[0]!=='' && days.indexOf(dateKey(r[0]))<0; }).map(function(r){ var x=r.slice(0,w); while(x.length<w) x.push(''); return x; });
  var moi=dong.map(function(r){ var x=r.slice(0,6); while(x.length<w) x.push(''); return x; }), tat=giu.concat(moi);
  if(sh.getLastRow()>1) sh.getRange(2,1,sh.getLastRow()-1,w).clearContent(); if(tat.length) sh.getRange(2,1,tat.length,w).setValues(tat); }
// Xem trước: đọc tuần trong file quán + kiểm tra (không ghi gì)
function xemLichQuan(p){ if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'}; var monday=mondayOf(p.tuan);
  var nh=p.nguon==='web'?docNhapLuoi_(monday,'nhap'):null; if(p.nguon==='web' && !nh) return {ok:false,msg:'Tuần này chưa có bản nháp web.'};
  var k=phanTichLichQuan_(monday, p.tab||'', nh&&nh.luoi); if(!k.ca.length) return {ok:false, msg:'Chưa đọc được ca nào của tuần '+monday.slice(8)+'/'+monday.slice(5,7)+' trong file lịch quán.'+(k.loi.length?' '+k.loi.join(' · '):''), loi:k.loi};
  delete k.ca; k.hienTai=lichTuanHienTai_(monday).length; return k; }
// Áp dụng: ghi lịch chính thức (chủ quán / admin), lưu phiên bản; còn buổi thiếu pha chế thì phải xác nhận lại
function apDungLichQuan(p){ if(authRole(p.pin)!=='admin') return {ok:false,msg:'Chỉ admin (chủ quán) mới áp dụng lịch chính thức'}; var monday=mondayOf(p.tuan);
  var nh=p.nguon==='web'?docNhapLuoi_(monday,'nhap'):null; if(p.nguon==='web' && !nh) return {ok:false,msg:'Tuần này chưa có bản nháp web.'};
  var k=phanTichLichQuan_(monday, p.tab||'', nh&&nh.luoi); if(!k.ca.length) return {ok:false, msg:'Chưa đọc được ca nào của tuần này.', loi:k.loi};
  if(k.thieuPC.length && !p.dongYThieuPC) return {ok:false, canXacNhan:true, msg:'Còn '+k.thieuPC.length+' buổi KHÔNG có người biết pha chế. Sửa trong file quán, hoặc bấm áp dụng lần nữa để vẫn áp dụng.', thieuPC:k.thieuPC};
  var lock=LockService.getScriptLock(); lock.waitLock(30000);
  try{ var cu=lichTuanHienTai_(monday), daCo=rows('LichPhienBan').filter(function(r){ return dateKey(r.Tuan)===monday; }).length;
    if(cu.length && !daCo) luuPhienBan_(monday, 'App', 'lịch trước khi áp dụng', 'Bản lịch đang có trước lần áp dụng đầu tiên', cu);   // để còn lấy lại được
    var dong=k.ca.map(function(c){ var ma=maCaTheoGio_(c.cs, c.bd, c.kt); return [c.ngay, c.cs, c.ma, ma, c.vitri, [c.gay?'Ca gãy':'', c.tc?'Tăng ca':'', c.coDinh?'Cố định (tự thêm)':''].filter(Boolean).join(' · ')]; }).filter(function(r){ return r[3]; });
    ghiLichTuan_(monday, dong);
    var so=luuPhienBan_(monday, 'Admin', p.nguon==='web'?'bản nháp web':(p.tab?('tab "'+p.tab+'"'):'file lịch quán'), p.ghiChu||'', dong);
  } finally { lock.releaseLock(); }
  var hoc=null; try{ hoc=chotLich({pin:p.pin, tuan:monday}); }catch(e){}
  return {ok:true, phienBan:so, soCa:dong.length, soNguoi:k.soNguoi, thieu:k.thieu.length, thieuPC:k.thieuPC.length, hoc:hoc&&hoc.msg||''}; }
function dsPhienBanLich(p){ if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'}; var monday=mondayOf(p.tuan);
  var L=(SS.getSheetByName('LichPhienBan')?rows('LichPhienBan'):[]).filter(function(r){ return dateKey(r.Tuan)===monday; }).sort(function(a,b){ return (+b.So)-(+a.So); });
  return {ok:true, tuan:monday, list:L.map(function(r,i){ return {So:+r.So, Luc:r.Luc instanceof Date?fmtTZ_(r.Luc,TZ,'dd/MM HH:mm'):String(r.Luc), Boi:r.Boi, Nguon:r.Nguon, GhiChu:r.GhiChu, SoCa:+r.SoCa, dangDung:i===0}; })}; }
function khoiPhucLich(p){ if(authRole(p.pin)!=='admin') return {ok:false,msg:'Chỉ admin'}; var monday=mondayOf(p.tuan);
  var r=(SS.getSheetByName('LichPhienBan')?rows('LichPhienBan'):[]).filter(function(x){ return dateKey(x.Tuan)===monday && +x.So===+p.so; })[0]; if(!r) return {ok:false,msg:'Không tìm thấy phiên bản'};
  var dong; try{ dong=JSON.parse(r.DuLieu); }catch(e){ return {ok:false,msg:'Phiên bản bị hỏng dữ liệu'}; }
  var lock=LockService.getScriptLock(); lock.waitLock(30000); try{ ghiLichTuan_(monday, dong); var so=luuPhienBan_(monday, 'Admin', 'khôi phục bản '+r.So, p.ghiChu||'', dong); } finally { lock.releaseLock(); }
  return {ok:true, phienBan:so, soCa:dong.length}; }

/* =====================================================================================================
   BẢN NHÁP WEB (28/10): trang tính nhỏ bố cục Y HỆT tab "Lịch T10" (CFMH) và file LĐD.
   Lưu dạng {CFMH:{v,bg,dam}, LDD:{v,bg,dam}} – v: chữ trong ô (ngày ghi "D:yyyy-mm-dd"), bg: màu nền, dam: dòng chữ đậm.
   App xếp gợi ý → ghi thẳng vào bản nháp; quản lý sửa trên web (như Google Sheet) hoặc Xuất ra Google Sheet khi muốn.
   ===================================================================================================== */
function MemRange_(sh,r,c,nr,nc){ this.sh=sh; this.r=r; this.c=c; this.nr=nr||1; this.nc=nc||1; }
MemRange_.prototype.setValues=function(v){ for(var i=0;i<v.length;i++){ var row=this.sh.v[this.r-1+i]=this.sh.v[this.r-1+i]||[]; for(var j=0;j<v[i].length;j++) row[this.c-1+j]=v[i][j]; } return this; };
MemRange_.prototype.setValue=function(x){ return this.setValues([[x]]); };
MemRange_.prototype.setBackgrounds=function(b){ for(var i=0;i<b.length;i++){ var row=this.sh.bg[this.r-1+i]=this.sh.bg[this.r-1+i]||[]; for(var j=0;j<b[i].length;j++) row[this.c-1+j]=b[i][j]; } return this; };
MemRange_.prototype.setFontWeight=function(w){ if(w==='bold') for(var i=0;i<this.nr;i++) this.sh.dam[this.r-1+i]=1; return this; };
['setFontFamily','setHorizontalAlignment','setVerticalAlignment','setWrap','setFontColor','merge','setBorder','setNumberFormat','setFontSize','clearContent'].forEach(function(m){ MemRange_.prototype[m]=function(){ return this; }; });
function MemSheet_(n){ this.n=n; this.v=[]; this.bg=[]; this.dam={}; }
MemSheet_.prototype.clear=function(){ this.v=[]; this.bg=[]; this.dam={}; return this; };
MemSheet_.prototype.getRange=function(r,c,nr,nc){ return typeof r==='string'?new MemRange_(this,1,1,1,1):new MemRange_(this,r,c,nr,nc); };
['hideColumns','setColumnWidth','setFrozenRows','setFrozenColumns'].forEach(function(m){ MemSheet_.prototype[m]=function(){ return this; }; });
function MemSS_(){ this.tabs={}; }
MemSS_.prototype.getSheetByName=function(n){ return this.tabs[n]||null; };
MemSS_.prototype.insertSheet=function(n){ return (this.tabs[n]=new MemSheet_(n)); };
var NHAP_RONG={CFMH:17, LDD:9};
function mauChuan_(x){ x=String(x||'').toLowerCase(); return /^#[0-9a-f]{6}$/.test(x)?x:'#ffffff'; }
function luoiTuMem_(sh, rong){ var R=sh.v.length, v=[], bg=[], dam=[];
  for(var r=0;r<R;r++){ var row=[], rb=[]; for(var c=0;c<rong;c++){ var x=sh.v[r]&&sh.v[r][c]; if(x instanceof Date) x='D:'+fmtDate(x); row.push(x==null?'':String(x)); rb.push(mauChuan_(sh.bg[r]&&sh.bg[r][c])); } v.push(row); bg.push(rb); if(sh.dam[r]) dam.push(r); }
  while(v.length && !v[v.length-1].join('') && bg[bg.length-1].every(function(x){ return x==='#ffffff'; })){ v.pop(); bg.pop(); }
  return {v:v, bg:bg, dam:dam}; }
function luoiTuKeHoach_(days, stores, plan, gaps, off, byMa, caMap){ var m=new MemSS_();
  writeWeekSheet(days, stores, plan, gaps||[], off||{}, byMa, caMap, 'CFMH', m); writeLddSheet(days, plan, gaps||[], off||{}, byMa, caMap, 'LDD', m);
  return {CFMH:luoiTuMem_(m.tabs.CFMH, NHAP_RONG.CFMH), LDD:luoiTuMem_(m.tabs.LDD, NHAP_RONG.LDD)}; }
// ---- lưu / đọc bản nháp (tự chia nhỏ vì 1 ô Google Sheet tối đa 50.000 ký tự)
var NHAP_COT=['Tuan','Loai','Phan','Luc','Boi','Nguon','Data'];
function nhapSh_(){ var sh=SS.getSheetByName('NhapLuoi'); if(!sh){ sh=SS.insertSheet('NhapLuoi'); sh.getRange(1,1,1,NHAP_COT.length).setValues([NHAP_COT]); try{ sh.getRange(1,1,sh.getMaxRows(),3).setNumberFormat('@'); }catch(e){} } return sh; }
function ghiNhapLuoi_(tuan, loai, luoi, boi, nguon){ var sh=nhapSh_(), all=sh.getDataRange().getValues(), h=all.shift();
  var giu=all.filter(function(r){ return r[0]!=='' && !(String(r[0]).slice(0,10)===tuan && String(r[1])===loai); });
  var js=JSON.stringify(luoi), phan=[]; for(var i=0;i<js.length;i+=40000) phan.push(js.slice(i,i+40000)); if(!phan.length) phan.push('');
  var moi=phan.map(function(x,i){ return [tuan, loai, i, new Date(), boi||'', nguon||'', x]; }), tat=giu.concat(moi);
  if(sh.getLastRow()>1) sh.getRange(2,1,sh.getLastRow()-1,NHAP_COT.length).clearContent();
  if(tat.length) sh.getRange(2,1,tat.length,NHAP_COT.length).setValues(tat); }
function docNhapLuoi_(tuan, loai){ var sh=SS.getSheetByName('NhapLuoi'); if(!sh) return null; loai=loai||'nhap';
  var L=rows('NhapLuoi').filter(function(r){ return String(r.Tuan).slice(0,10)===tuan && String(r.Loai)===loai; }).sort(function(a,b){ return (+a.Phan)-(+b.Phan); });
  if(!L.length) return null; var luoi; try{ luoi=JSON.parse(L.map(function(r){ return String(r.Data); }).join('')); }catch(e){ return null; }
  return {luoi:luoi, luc:L[0].Luc instanceof Date?fmtTZ_(L[0].Luc,TZ,'dd/MM HH:mm'):String(L[0].Luc), boi:L[0].Boi, nguon:L[0].Nguon}; }
function luuNhapMoi_(tuan, luoi, boi, nguon){ var cu=docNhapLuoi_(tuan,'nhap'); if(cu) ghiNhapLuoi_(tuan, 'truoc', cu.luoi, cu.boi, cu.nguon);   // giữ bản nháp trước để lấy lại
  ghiNhapLuoi_(tuan, 'nhap', luoi, boi, nguon); }
// ---- khoá: 1 người sửa 1 tuần (2 phút không lưu / không gõ thì tự nhả)
function khoaNhap_(tuan){ try{ var x=CacheService.getScriptCache().get('KHOA_NHAP_'+tuan); return x?JSON.parse(x):null; }catch(e){ return null; } }
function datKhoa_(tuan, token, ten){ try{ CacheService.getScriptCache().put('KHOA_NHAP_'+tuan, JSON.stringify({token:token, ten:ten, luc:fmtTZ_(new Date(),TZ,'HH:mm')}), 120); }catch(e){} }
function dsNVNhap_(){ return rows('NhanVien').filter(function(n){ return n.TrangThai!=='Đã nghỉ'; }).map(function(n){ return {MaNV:String(n.MaNV), Ten:String(n.Ten), TenNgan:tenNgan(n), ViTri:n.ViTri||'', ViTriKiem:n.ViTriKiem||'', ChucVu:n.ChucVu||'', CoSoChinh:n.CoSoChinh||'', CoDinh:n.CoDinh||''}; }); }
function layNhapLuoi(p){ var role=authRole(p.pin); if(!role) return {ok:false,msg:'Sai mã'}; nhanSuMoi_(); var monday=mondayOf(p.tuan), d=docNhapLuoi_(monday,'nhap'), k=khoaNhap_(monday);
  var hien=lichTuanHienTai_(monday).map(function(r){ return r.slice(0,4).join('|'); }).sort().join(';'), pb=(SS.getSheetByName('LichPhienBan')?rows('LichPhienBan'):[]).filter(function(r){ return dateKey(r.Tuan)===monday; }).sort(function(a,b){ return (+b.So)-(+a.So); })[0], lichChinhDoi=false;
  if(pb){ try{ lichChinhDoi=JSON.parse(pb.DuLieu).map(function(r){ return r.slice(0,4).join('|'); }).sort().join(';')!==hien; }catch(e){} }
  return {ok:true, tuan:monday, role:role, nhap:d, lichChinhDoi:lichChinhDoi, coTruoc:!!docNhapLuoi_(monday,'truoc'), khoa:(k && k.token!==p.token)?k:null, nv:dsNVNhap_(), dm:dmHienTai_(), lichChinh:lichTuanHienTai_(monday).length,
    file:{CFMH:'https://docs.google.com/spreadsheets/d/'+String(cfg('FILE_LICH_CFMH')||FILE_LICH_QUAN_MD.CFMH)+'/edit', LDD:'https://docs.google.com/spreadsheets/d/'+String(cfg('FILE_LICH_LDD')||FILE_LICH_QUAN_MD.LDD)+'/edit'}}; }
function luuNhapLuoi(p){ var role=authRole(p.pin); if(!role) return {ok:false,msg:'Sai mã'}; var monday=mondayOf(p.tuan), k=khoaNhap_(monday);
  if(k && k.token!==p.token && !p.giuQuyen) return {ok:false, khoa:k, msg:(k.ten||'Người khác')+' đang sửa bản nháp tuần này (từ '+k.luc+').'};
  if(!p.luoi || !p.luoi.CFMH || !p.luoi.LDD) return {ok:false,msg:'Thiếu dữ liệu bản nháp'};
  var lock=LockService.getScriptLock(); lock.waitLock(20000); try{ ghiNhapLuoi_(monday,'nhap',p.luoi,p.ten||role,'web'); datKhoa_(monday, p.token, p.ten||(role==='admin'?'Admin':'Quản lý')); } finally { lock.releaseLock(); }
  return {ok:true, luc:fmtTZ_(new Date(),TZ,'HH:mm:ss')}; }
function giuKhoaNhap(p){ if(!authRole(p.pin)) return {ok:false}; var monday=mondayOf(p.tuan), k=khoaNhap_(monday); if(k && k.token!==p.token && !p.giuQuyen) return {ok:false, khoa:k}; datKhoa_(monday, p.token, p.ten||'Quản lý'); return {ok:true}; }
function nhaKhoaNhap(p){ if(!authRole(p.pin)) return {ok:false}; var monday=mondayOf(p.tuan), k=khoaNhap_(monday); if(k && k.token===p.token){ try{ CacheService.getScriptCache().remove('KHOA_NHAP_'+monday); }catch(e){} } return {ok:true}; }
// ---- tạo bản nháp: từ lịch chính thức đang dùng / lấy lại bản nháp trước / từ file quán
function taoNhapTuLichChinh(p){ if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'}; var monday=mondayOf(p.tuan), V=viewData(monday);
  if(!V.plan.length) return {ok:false,msg:'Tuần này chưa có lịch chính thức.'};
  luuNhapMoi_(monday, luoiTuKeHoach_(V.days, V.stores, V.plan, [], V.off, V.byMa, V.caMap), authRole(p.pin)==='admin'?'Admin':'Quản lý', 'từ lịch chính thức'); return {ok:true}; }
function layLaiNhapTruoc(p){ if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'}; var monday=mondayOf(p.tuan), t=docNhapLuoi_(monday,'truoc'), n=docNhapLuoi_(monday,'nhap'); if(!t) return {ok:false,msg:'Không có bản nháp trước'};
  ghiNhapLuoi_(monday,'nhap',t.luoi,t.boi,t.nguon); if(n) ghiNhapLuoi_(monday,'truoc',n.luoi,n.boi,n.nguon); return {ok:true}; }
// cắt đúng khối 1 tuần trong tab (tab tháng của quán hoặc tab "Nháp dd.mm") → lưới
function catKhoiTuan_(v, bg, kieu, monday){ var R=v.length, rong=NHAP_RONG[kieu], tim=/LỊCH (PHỤC VỤ|LÊ ĐÌNH)/i, dau=-1, cuoi=R;
  var laNgay=function(r){ for(var c0=0;c0<=6;c0++){ var ok=true; for(var i=0;i<7;i++){ var d=lichNgay_(v[r][c0+i]); if(!d || lichNgayKey_(d)!==fmtDate(addDays(new Date(monday+'T12:00:00+07:00'),i))){ ok=false; break; } } if(ok) return c0; } return -1; };
  for(var r=0;r<R;r++){ var c0=laNgay(r); if(c0>=0){ dau=r; for(var k=r;k>=Math.max(0,r-4);k--){ if(v[k].some(function(x){ return tim.test(String(x)); })){ dau=k; break; } } var dich=kieu==='LDD'?Math.max(0,c0-2):0; break; } }
  if(dau<0) return null; for(var r2=dau+3;r2<R;r2++){ if(v[r2].some(function(x){ return tim.test(String(x)); })){ cuoi=r2; break; } }
  var out={v:[], bg:[], dam:[]}; for(var r3=dau;r3<cuoi;r3++){ var row=[], rb=[]; for(var c=0;c<rong;c++){ var x=v[r3][c+dich]; if(x instanceof Date) x='D:'+fmtDate(x); row.push(x==null?'':String(x)); rb.push(mauChuan_(bg[r3]&&bg[r3][c+dich])); } out.v.push(row); out.bg.push(rb); if(r3-dau<3) out.dam.push(r3-dau); }
  while(out.v.length && !out.v[out.v.length-1].join('')){ out.v.pop(); out.bg.pop(); } return out; }
function layNhapTuSheet(p){ if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'}; var monday=mondayOf(p.tuan), luoi={}, loi=[];
  ['CFMH','LDD'].forEach(function(k){ try{ var ss=fileLichQuan_(k), tabs=p.tab?[ss.getSheetByName(p.tab)].filter(Boolean):tabThangLich_(ss, monday), kq=null;
      tabs.forEach(function(sh){ if(kq) return; var rg=sh.getDataRange(); kq=catKhoiTuan_(rg.getValues(), rg.getBackgrounds(), k, monday); });
      if(kq) luoi[k]=kq; else loi.push(tenFileLich_(k)+': không thấy tuần '+monday.slice(8)+'/'+monday.slice(5,7)+(p.tab?' trong tab "'+p.tab+'"':'')); }catch(e){ loi.push(tenFileLich_(k)+': '+e.message); } });
  if(!luoi.CFMH && !luoi.LDD) return {ok:false, msg:loi.join(' · ')};
  var cu=docNhapLuoi_(monday,'nhap'); ['CFMH','LDD'].forEach(function(k){ if(!luoi[k]) luoi[k]=cu?cu.luoi[k]:{v:[],bg:[],dam:[]}; });
  luuNhapMoi_(monday, luoi, authRole(p.pin)==='admin'?'Admin':'Quản lý', p.tab?('lấy từ tab "'+p.tab+'"'):'lấy từ tab tháng file quán'); return {ok:true, loi:loi}; }
// ---- xuất bản nháp ra Google Sheet (tab "Nháp dd.mm" trong file quán) khi muốn sửa / in ở đó
function xuatNhapRaSheet(p){ if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'}; var monday=mondayOf(p.tuan), d=docNhapLuoi_(monday,'nhap'); if(!d) return {ok:false,msg:'Tuần này chưa có bản nháp'};
  var ten='Nháp '+monday.slice(8,10)+'.'+monday.slice(5,7), kq=[];
  ['CFMH','LDD'].forEach(function(k){ var L=d.luoi[k]; if(!L || !L.v.length) return; try{ var ss=fileLichQuan_(k), sh=ss.getSheetByName(ten); if(sh) sh.clear(); else sh=ss.insertSheet(ten);
      var rong=NHAP_RONG[k], v=L.v.map(function(r){ var x=r.slice(0,rong); while(x.length<rong) x.push(''); return x.map(function(c){ return /^D:\d{4}-\d{2}-\d{2}$/.test(c)?new Date(c.slice(2)+'T12:00:00+07:00'):c; }); }), bg=L.bg.map(function(r){ var x=r.slice(0,rong); while(x.length<rong) x.push('#ffffff'); return x; });
      sh.getRange(1,1,v.length,rong).setValues(v).setBackgrounds(bg).setFontFamily('Times New Roman').setHorizontalAlignment('center').setVerticalAlignment('middle').setWrap(true);
      (L.dam||[]).forEach(function(r){ if(r<v.length) sh.getRange(r+1,1,1,rong).setFontWeight('bold'); });
      try{ v.forEach(function(r,i){ r.forEach(function(c,j){ if(c instanceof Date) sh.getRange(i+1,j+1).setNumberFormat('dd/MM'); }); }); }catch(e){}
      for(var c=1;c<=rong;c++) sh.setColumnWidth(c, (c===1||(k==='CFMH'&&c===10))?110:((k==='CFMH'&&c===9)?20:118)); sh.setFrozenRows(3);
      kq.push({ten:tenFileLich_(k), tab:ten, url:ss.getUrl()}); }catch(e){ kq.push({ten:tenFileLich_(k), loi:String(e.message||e)}); } });
  ghiNhapLuoi_(monday,'nhap',d.luoi,d.boi,'sheet:'+ten); return {ok:true, file:kq, tab:ten}; }

/* =====================================================================================================
   HỌC TỪ CHẤM CÔNG THẬT (28/10): mỗi tháng (và khi admin bấm) đọc chấm công 70 ngày gần nhất →
   • tóm tắt từng ngày (quán × buổi: ai có mặt, ai biết pha chế; mỗi người làm vị trí gì) lưu vào HocCCNgay (không mất khi chấm công đã lưu trữ)
   • ĐỊNH MỨC người mỗi buổi tính lại từ 8 tuần gần nhất → admin xem cũ / mới, bấm chấp nhận mới dùng
   • ĐỀ XUẤT VỊ TRÍ KIÊM: làm vị trí X ≥ 6 ca trong 8 tuần mà hồ sơ chưa có → đề xuất thêm; vị trí kiêm 8 tuần không làm → báo "lâu chưa làm"
   Bỏ qua giờ nạp từ file cũ (không có vị trí / quán thật) và ca chưa có giờ ra.
   ===================================================================================================== */
var HOC_KH={'Sáng':[390,720],'Trưa':[720,1020],'Tối':[1020,1350]}, HOC_NGAY=56, HOC_VT_MIN=6;
function vtChuan_(v){ v=String(v||'').trim().toLowerCase(); if(/pha/.test(v)) return 'Pha chế'; if(/phục|phuc|pv/.test(v)) return 'Phục vụ'; if(/thu ng/.test(v)) return 'Thu ngân'; if(/rửa|rua/.test(v)) return 'Rửa ly'; if(/bảo|bao v/.test(v)) return 'Bảo vệ'; if(/quản|quan ly|trưởng/.test(v)) return 'Quản lý'; return ''; }
function dsViTriNV_(n){ var a=[vtChuan_(n.ViTri)].concat(String(n.ViTriKiem||'').split(/[,;\/]/).map(vtChuan_)).filter(Boolean), o={}; a.forEach(function(x){ o[x]=1; }); return o; }
function dmHienTai_(){ var sh=SS.getSheetByName('DinhMucLich'); if(!sh || sh.getLastRow()<2) return DM_LICH_CU; var o={}; rows('DinhMucLich').forEach(function(r){ try{ o[String(r.Khoa)]=JSON.parse(r.GiaTri); }catch(e){} }); return Object.keys(o).length?o:DM_LICH_CU; }
function hocCCSh_(){ var sh=SS.getSheetByName('HocCCNgay'); if(!sh){ sh=SS.insertSheet('HocCCNgay'); sh.getRange(1,1,1,3).setValues([['Ngay','CapNhat','DuLieu']]); try{ sh.getRange('A:A').setNumberFormat('@'); }catch(e){} } return sh; }
// 1. tóm tắt chấm công theo ngày
function tomTatChamCong_(){ var ss=ccSheet(); if(!ss) return {loi:'Chưa nối được app Chấm công: '+_CCLOI};
  var tu=fmtDate(addDays(new Date(),-70)), homNay=fmtDate(new Date()), byMa={}; rows('NhanVien').forEach(function(n){ byMa[up(n.MaNV)]=n; });
  var cc=ccRowsTu(ss,'ChamCong'), N={}, soCa=0, boNap=0;
  cc.forEach(function(r){ var d=dateKey(r.Ngay); if(!d || d<tu || d>=homNay) return;
    if(/nạp|nap tu file/i.test(String(r.Cach||'')+' '+String(r.KhaiLoai||''))){ boNap++; return; }
    var bd=toMin(fmtCa(r.CoMat||r.KhaiTu||r.Vao)), kt=toMin(fmtCa(r.KhaiDen||r.Ra)); if(bd==null || kt==null || kt<=bd || !r.MaCS) return;
    var ma=up(r.MaNV), vt=vtChuan_(r.ViTri)||vtChuan_((byMa[ma]||{}).ViTri), x=N[d]=N[d]||{dem:{}, vt:{}}; soCa++;
    Object.keys(HOC_KH).forEach(function(k){ var a=HOC_KH[k][0], b=HOC_KH[k][1]; if(Math.min(kt,b)-Math.max(bd,a)>=60){ var key=up(r.MaCS)+'|'+k, o=x.dem[key]=x.dem[key]||{t:{},p:{}}; o.t[ma]=1; if(vt==='Pha chế'||vt==='Quản lý'||laBietPC_(byMa[ma])) o.p[ma]=1; } });
    if(vt){ var v=x.vt[ma]=x.vt[ma]||{}; v[vt]=(v[vt]||0)+1; } });
  var sh=hocCCSh_(), all=sh.getDataRange().getValues(), h=all.shift(), moi=Object.keys(N);
  var giu=all.filter(function(r){ return r[0]!=='' && moi.indexOf(String(r[0]).slice(0,10))<0 && String(r[0]).slice(0,10)>=fmtDate(addDays(new Date(),-400)); });
  var ghi=giu.concat(moi.sort().map(function(d){ var x=N[d], dem={}; Object.keys(x.dem).forEach(function(k){ dem[k]=[Object.keys(x.dem[k].t), Object.keys(x.dem[k].p)]; }); return [d, new Date(), JSON.stringify({dem:dem, vt:x.vt})]; }));
  if(sh.getLastRow()>1) sh.getRange(2,1,sh.getLastRow()-1,3).clearContent(); if(ghi.length) sh.getRange(2,1,ghi.length,3).setValues(ghi);
  return {soNgay:moi.length, soCa:soCa, boNap:boNap}; }
function pctHoc_(a,p){ var s=a.slice().sort(function(x,y){ return x-y; }); return s[Math.min(s.length-1,Math.floor(p*(s.length-1)+0.5))]; }
// 2. định mức + đề xuất vị trí từ tóm tắt 8 tuần gần nhất
function hocTuChamCong_(){ var tt=tomTatChamCong_(); if(tt.loi) return {ok:false, msg:tt.loi};
  var tu=fmtDate(addDays(new Date(),-HOC_NGAY)), D=(SS.getSheetByName('HocCCNgay')?rows('HocCCNgay'):[]).map(function(r){ var x; try{ x=JSON.parse(r.DuLieu); }catch(e){ x=null; } return {ngay:String(r.Ngay).slice(0,10), x:x}; }).filter(function(o){ return o.x && o.ngay>=tu; });
  var soNgay=D.length, A={}, VT={}, CA={};
  D.forEach(function(o){ var loai=(dowOf(o.ngay)===0||dowOf(o.ngay)===6)?'CT':'NT';
    Object.keys(o.x.dem).forEach(function(k){ var p=k.split('|'), key=p[0]+'|'+p[1]+'|'+loai, v=o.x.dem[k]; (A[key]=A[key]||[]).push({t:v[0].length, p:v[1].length}); });
    Object.keys(o.x.vt).forEach(function(ma){ var v=o.x.vt[ma]; VT[ma]=VT[ma]||{}; Object.keys(v).forEach(function(x){ VT[ma][x]=(VT[ma][x]||0)+v[x]; CA[ma]=(CA[ma]||0)+v[x]; }); }); });
  var cu=dmHienTai_(), moi={}, doi=0, du=soNgay>=21;
  Object.keys(A).forEach(function(k){ var a=A[k]; if(a.length<6) return; var t=a.map(function(x){ return x.t; }), p=a.map(function(x){ return x.p; });
    moi[k]={tong:[pctHoc_(t,.25),pctHoc_(t,.5)], pc:[Math.max(1,pctHoc_(p,.1)),pctHoc_(p,.5)], n:a.length}; var c=cu[k]; if(!c || c.tong[0]!==moi[k].tong[0] || c.tong[1]!==moi[k].tong[1] || c.pc[0]!==moi[k].pc[0] || c.pc[1]!==moi[k].pc[1]) doi++; });
  var byMa={}, dx=[]; rows('NhanVien').filter(function(n){ return n.TrangThai!=='Đã nghỉ'; }).forEach(function(n){ byMa[up(n.MaNV)]=n; });
  Object.keys(VT).forEach(function(ma){ var n=byMa[ma]; if(!n) return; var co=dsViTriNV_(n);
    Object.keys(VT[ma]).forEach(function(v){ if(!co[v] && VT[ma][v]>=HOC_VT_MIN && v!=='Quản lý') dx.push({ma:ma, ten:tenNgan(n), lam:'them', vitri:v, so:VT[ma][v], tong:CA[ma], hoSo:n.ViTri+(n.ViTriKiem?' · kiêm: '+n.ViTriKiem:'')}); }); });
  Object.keys(byMa).forEach(function(ma){ var n=byMa[ma], tong=CA[ma]||0; if(tong<10) return; String(n.ViTriKiem||'').split(/[,;\/]/).map(vtChuan_).filter(Boolean).forEach(function(v){ if(!(VT[ma]||{})[v] && v!==vtChuan_(n.ViTri)) dx.push({ma:ma, ten:tenNgan(n), lam:'bo', vitri:v, so:0, tong:tong, hoSo:n.ViTri+' · kiêm: '+n.ViTriKiem}); }); });
  var kq={luc:fmtTZ_(new Date(),TZ,'dd/MM/yyyy HH:mm'), tu:tu, soNgay:soNgay, du:du, moi:moi, doi:doi, vitri:dx, tt:tt};
  setCfg('HOC_CC_KQ', JSON.stringify(kq)); return {ok:true, kq:kq}; }
function hocTuDongThang(){ try{ hocTuChamCong_(); }catch(e){} }   // chạy cùng bảo trì đầu tháng
function layHocCC(p){ if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'}; var kq=null; if(p.chayLai){ var r=hocTuChamCong_(); if(!r.ok) return r; kq=r.kq; } else { try{ kq=JSON.parse(cfg('HOC_CC_KQ')||'null'); }catch(e){} }
  var dang=dmHienTai_(); return {ok:true, kq:kq, dang:dang, nguonDang:(SS.getSheetByName('DinhMucLich')&&SS.getSheetByName('DinhMucLich').getLastRow()>1)?String(cfg('DM_LICH_NGUON')||'chấm công'):'lịch thật 6–10/2026', role:authRole(p.pin)}; }
function apDungDinhMucMoi(p){ if(authRole(p.pin)!=='admin') return {ok:false,msg:'Chỉ admin'}; var kq; try{ kq=JSON.parse(cfg('HOC_CC_KQ')||'null'); }catch(e){} if(!kq || !kq.du) return {ok:false,msg:'Chưa đủ dữ liệu chấm công (cần ≥ 3 tuần) để thay định mức'};
  var gop={}, cu=dmHienTai_(); Object.keys(cu).forEach(function(k){ gop[k]=cu[k]; }); Object.keys(kq.moi).forEach(function(k){ gop[k]=kq.moi[k]; });   // buổi nào chưa đủ dữ liệu thì giữ mức cũ
  var sh=SS.getSheetByName('DinhMucLich'); if(!sh){ sh=SS.insertSheet('DinhMucLich'); } sh.clear(); var v=[['Khoa','GiaTri']].concat(Object.keys(gop).sort().map(function(k){ return [k, JSON.stringify(gop[k])]; })); sh.getRange(1,1,v.length,2).setValues(v);
  setCfg('DM_LICH_NGUON','chấm công '+kq.tu.slice(8)+'/'+kq.tu.slice(5,7)+' → '+kq.luc.slice(0,5)); return {ok:true, so:Object.keys(kq.moi).length}; }
function duyetViTriKiem(p){ if(authRole(p.pin)!=='admin') return {ok:false,msg:'Chỉ admin'}; var sh=SS.getSheetByName('NhanVien'), v=sh.getDataRange().getValues(), h=v[0], im=h.indexOf('MaNV'), ik=h.indexOf('ViTriKiem');
  if(ik<0) return {ok:false,msg:'Thiếu cột ViTriKiem'}; for(var i=1;i<v.length;i++){ if(up(v[i][im])!==up(p.ma)) continue;
    var ds=String(v[i][ik]||'').split(/[,;\/]/).map(function(x){ return x.trim(); }).filter(Boolean);
    if(p.lam==='them' && !ds.some(function(x){ return vtChuan_(x)===p.vitri; })) ds.push(p.vitri);
    if(p.lam==='bo') ds=ds.filter(function(x){ return vtChuan_(x)!==p.vitri; });
    sh.getRange(i+1,ik+1).setValue(ds.join(', ')); ghiNhanSuCC_(p.ma, 'ViTriKiem', ds.join(', '));
    try{ var kq=JSON.parse(cfg('HOC_CC_KQ')||'null'); if(kq){ kq.vitri=kq.vitri.filter(function(x){ return !(up(x.ma)===up(p.ma) && x.vitri===p.vitri && x.lam===p.lam); }); setCfg('HOC_CC_KQ', JSON.stringify(kq)); } }catch(e){}
    return {ok:true, viTriKiem:ds.join(', ')}; }
  return {ok:false,msg:'Không tìm thấy nhân viên'}; }
function boQuaDeXuatViTri(p){ if(authRole(p.pin)!=='admin') return {ok:false,msg:'Chỉ admin'}; try{ var kq=JSON.parse(cfg('HOC_CC_KQ')||'null'); if(kq){ kq.vitri=kq.vitri.filter(function(x){ return !(up(x.ma)===up(p.ma) && x.vitri===p.vitri && x.lam===p.lam); }); setCfg('HOC_CC_KQ', JSON.stringify(kq)); } }catch(e){} return {ok:true}; }
