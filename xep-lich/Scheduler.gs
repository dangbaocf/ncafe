  var bcd=sheetOf('BanCoDinh',['MaNV','Thu','Khoi','Nguon']), cu=rows('BanCoDinh'), moi=0;
  Object.keys(lap).forEach(function(k){ if(Object.keys(lap[k]).length<3) return; var p=k.split('|');
    if(cu.some(function(b){ return up(b.MaNV)===p[0] && b.Thu===p[1] && b.Khoi===p[2]; })) return;
    bcd.appendRow([p[0],p[1],p[2],'Tự học: đăng ký bận '+Object.keys(lap[k]).length+' tuần liền']); moi++; });
  return moi;
}


/* ================= KHẢO SÁT NHÂN VIÊN (làm 1 lần, part time cập nhật mục thời gian mỗi học kỳ) ================= */
function ksNV(maNV, sdt4){ var ma=up(maNV), nv=rows('NhanVien').filter(function(n){ return up(n.MaNV)===ma; })[0];
  if(!nv) return {loi:'Không tìm thấy mã '+ma}; if(['Đã nghỉ','Nghỉ việc'].indexOf(String(nv.TrangThai||''))>-1) return {loi:nv.Ten+' không còn trong danh sách đang làm'};
  var sdt=String(nv.SDT||'').replace(/\D/g,''); if(sdt.length>=4 && String(sdt4||'')!==sdt.slice(-4)) return {loi:'4 số cuối điện thoại không khớp'};
  return {nv:nv}; }
function ksDocTatCa(){ var o={}; if(SS.getSheetByName('KhaoSat')) rows('KhaoSat').forEach(function(r){ try{ o[up(r.MaNV)]={data:JSON.parse(r.DuLieu||'{}'), gui:r.NgayGui, xacNhan:r.XacNhan}; }catch(e){} }); return o; }
function getKhaoSat(p){
  var k=ksNV(p.maNV,p.sdt4); if(k.loi) return {ok:false,msg:k.loi}; var nv=k.nv, all=ksDocTatCa(), cu=all[up(nv.MaNV)];
  return {ok:true, nv:{MaNV:String(nv.MaNV),Ten:tenNgan(nv),ViTri:nv.ViTri,Loai:nv.Loai,CoSoChinh:nv.CoSoChinh}, stores:rows('CoSo').map(function(c){ return {MaCS:c.MaCS,TenCS:c.TenCS}; }), data:cu?cu.data:null};
}
function luuKhaoSat(p){
  var k=ksNV(p.maNV,p.sdt4); if(k.loi) return {ok:false,msg:k.loi}; var nv=k.nv, ma=up(nv.MaNV), d=p.data||{};
  var sh=sheetOf('KhaoSat',['MaNV','NgayGui','DuLieu','XacNhan','NgayXacNhan']), v=sh.getDataRange().getValues(), row=-1;
  for(var i=1;i<v.length;i++) if(up(v[i][0])===ma){ row=i+1; break; }
  var val=[ma, new Date(), JSON.stringify(d), '', ''];
  if(row>0) sh.getRange(row,1,1,5).setValues([val]); else sh.appendRow(val);
  // phần áp dụng ngay (thông tin thời gian / quán của chính nhân viên): bận cố định, ngày nghỉ, quán không tiện
  var TK=['T2','T3','T4','T5','T6','T7','CN'], KH=['Sáng','Trưa','Tối'];
  var bcd=sheetOf('BanCoDinh',['MaNV','Thu','Khoi','Nguon']), bv=bcd.getDataRange().getValues();
  for(var j=bv.length-1;j>=1;j--) if(up(bv[j][0])===ma && /^Khảo sát/.test(String(bv[j][3]||''))) bcd.deleteRow(j+1);
  var ranh=d.ranh||{}, coRanh=Object.keys(ranh).some(function(x){ return ranh[x]; });
  if(coRanh) TK.forEach(function(t){ KH.forEach(function(kh){ if(!ranh[t+'|'+kh]) bcd.appendRow([ma,t,kh,'Khảo sát: không rảnh']); }); });
  if(d.nghiThu && TK.indexOf(d.nghiThu)>-1) bcd.appendRow([ma,d.nghiThu,'Cả ngày','Khảo sát: ngày nghỉ']);
  var kx=sheetOf('KhongXep',['MaNV','MaCS','ViTri','Nguon']), kv=kx.getDataRange().getValues();
  for(var q=kv.length-1;q>=1;q--) if(up(kv[q][0])===ma && /^Khảo sát/.test(String(kv[q][3]||''))) kx.deleteRow(q+1);
  (d.quanKhongTien||[]).forEach(function(cs){ kx.appendRow([ma,cs,'','Khảo sát: không tiện đi']); });
  return {ok:true};
}
// Quản lý xem câu trả lời, xác nhận phần kỹ năng (vị trí kiêm, tăng ca) rồi app mới dùng
function dsKhaoSat(p){
