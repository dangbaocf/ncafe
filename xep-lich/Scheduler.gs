  // Hạn đăng ký lịch tuần sau: trước thứ 7; chậm nhất hết chủ nhật (trễ thì ghi "trễ hạn"); qua thứ 2 thì không nhận nữa, báo quản lý
  var hanCN=new Date(days[0]+'T00:00:00+07:00').getTime(), hanT7=hanCN-2*864e5, bayGio=new Date().getTime();
