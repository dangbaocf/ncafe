      if(['Rửa ly'].indexOf(n.ViTri)>-1 && pos!=='Rửa ly') return;
      if(!hopViTri(n,cs,blk,pos) || camXep(n._ma,cs.MaCS,pos)) return; if(busy(n._ma,d,blk)) return;
      var code=shiftsFor(n,cs,blk)[0]; if(!code) return;
      Object.keys(S[n._ma].days).forEach(function(d2){
        var mine=S[n._ma].days[d2]; if(mine.length!==1) return; var a2=mine[0]; if(/Support|gãy/.test(a2.GhiChu||'')) return;
        if(!boDuoc(a2)) return;
        // dựa trên lịch đã xếp trước đây: ưu tiên người hay làm thứ d, hay làm quán đó; ngày nghỉ mới d2 nên là thứ họ thường nghỉ;
        // ưu tiên bỏ ca không có trong lịch cũ (giữ đúng người theo lịch cũ)
        var TK=['CN','T2','T3','T4','T5','T6','T7'], wdD=(n._wd[TK[dowOf(d)]]||0), wdD2=(n._wd[TK[dowOf(d2)]]||0);
        if(Object.keys(n._wd).length && wdD<0.08) return;   // lịch cũ hầu như không làm thứ này → không đổi
        var sc=(n._cs[cs.MaCS]||0)*3 + (n._pos.indexOf(pos)>-1?2:0) + (n._tier==='cot'?1:0) + wdD*4 - wdD2*4 + (a2._mau?-1.5:0.5) - Math.abs(caMap[code].SoGio-caMap[a2.MaCa].SoGio)*0.1;
        if(sc>bs){ bs=sc; best={n:n,a2:a2,code:code,d2:d2}; }
      });
    });
    if(!best) return false;
    boCa(best.a2); off[best.n._ma]=best.d2;
    applyAssign({Ngay:d,MaCS:cs.MaCS,MaNV:best.n._ma,MaCa:best.code,ViTri:pos,GhiChu:'Đổi OFF sang '+best.d2.slice(8,10)+'/'+(+best.d2.slice(5,7))});
    // nếu chỗ đó đang có người nhà lấp tạm thì bỏ bớt 1 người nhà
    var sp=plan.filter(function(x){ return x.MaCS===cs.MaCS && x.Ngay===d && /Support/.test(x.GhiChu||'') && viTriChuan(x.ViTri)===viTriChuan(pos) && caMap[x.MaCa]._blocks.indexOf(blk)>-1; })[0];
    if(sp){ boCa(sp); supportUsed=supportUsed.filter(function(x){return x!==sp;}); }
    doiOffLog.push(tenNgan(best.n)+': OFF '+d.slice(8,10)+'/'+(+d.slice(5,7))+' → '+best.d2.slice(8,10)+'/'+(+best.d2.slice(5,7))+', làm '+cs.MaCS+' '+blk.toLowerCase()+' ('+pos.toLowerCase()+')');
    return true;
  }
  if(String(cfg('TOI_UU_DOI_OFF')||'Có')!=='Không'){
    var vongTU=0, coCai=true;
    while(coCai && vongTU++<6){ coCai=false;
      gaps.filter(function(g){ return g.Muc==='thieu' && g.Thieu>0; }).forEach(function(g){
        while(g.Thieu>0 && doiOff(g)){ g.Thieu--; coCai=true; }
      });
      gaps=gaps.filter(function(g){ return g.Thieu>0; });
    }
  }

  // ---------- CẮT DƯ THEO MỨC TỐI ĐA (vd Đống Đa sáng ≤ 3 pha chế gồm quản lý) ----------
  // Ca nào vượt mức tối đa (thường do phải thêm quản lý / cốt cán): bỏ bớt 1 pha chế không phải quản lý, không phải cốt cán duy nhất,
  // mà bỏ đi các khối khác vẫn đủ tối thiểu; ưu tiên bỏ người không có trong lịch cũ.
  var catDu=[];
  TOI_DA_CUNG.forEach(function(h){ var cs=csMap[h[0]]; if(!cs) return;
    days.forEach(function(d){ var guard=0;
      while(covered(cs.MaCS,d,h[1],h[2]).length>h[3] && guard++<5){
        var ung=plan.filter(function(a){ return a.MaCS===cs.MaCS && a.Ngay===d && caMap[a.MaCa]._blocks.indexOf(h[1])>-1 && viTriChuan(a.ViTri)===h[2] && !/Support/.test(a.GhiChu||''); })
          .filter(function(a){ var n=byMa[a.MaNV]; if(!n || isLeader(n)) return false; if(n._tier==='cot' && coCot(cs.MaCS,d,h[1])<=1) return false;
            return caMap[a.MaCa]._blocks.every(function(b){ return b===h[1] || covered(cs.MaCS,d,b,h[2]).length-1>=minNeed(cs,b,h[2]); }); })
          .sort(function(x,y){ return ((x._mau?1:0)-(y._mau?1:0)) || ((byMa[x.MaNV]._cs[cs.MaCS]||0)-(byMa[y.MaNV]._cs[cs.MaCS]||0)); });
        if(!ung.length) break;
        var a=ung[0]; boCa(a); catDu.push(tenNgan(byMa[a.MaNV])+' '+d.slice(8,10)+'/'+(+d.slice(5,7))+' '+cs.MaCS);
      }
    });
  });

  // ---------- TỐI ƯU: HOÁN ĐỔI để ca nào cũng có pha chế cốt cán ----------
  // Ca X chưa có cốt cán: tìm quán Y cùng ngày có ≥ 2 cốt cán trong ca đó; đổi chỗ 1 cốt cán p (Y → X) với 1 pha chế không cốt cán q (X → Y).
  // Mỗi người giữ nguyên giờ ca của mình; số người mỗi quán không đổi; Y vẫn còn cốt cán; quản lý bắt buộc vẫn đủ.
  var hoanDoiLog=[];
  function laPC(a){ return viTriChuan(a.ViTri)==='Pha chế' && !/Support/.test(a.GhiChu||''); }
  function motCaTrongNgay(a){ return (S[a.MaNV] && (S[a.MaNV].days[a.Ngay]||[]).length===1); }
  function conQL(csMa, d, bo, them){ var qb=QL_BAT_BUOC[csMa]; if(!qb) return true;
    var l=plan.filter(function(x){ return x!==bo && x.MaCS===csMa && x.Ngay===d && caMap[x.MaCa]._blocks.indexOf(qb)>-1 && byMa[x.MaNV] && isLeader(byMa[x.MaNV]); }).length;
    if(them && caMap[them.MaCa]._blocks.indexOf(qb)>-1 && byMa[them.MaNV] && isLeader(byMa[them.MaNV])) l++;
    return l>=1 || !(bo && isLeader(byMa[bo.MaNV]) && caMap[bo.MaCa]._blocks.indexOf(qb)>-1); }
  function hoanDoiCot(csX, d, blk){
    var best=null, bs=-1e9;
    plan.forEach(function(p){
      if(p.Ngay!==d || p.MaCS===csX.MaCS || !laPC(p) || !motCaTrongNgay(p)) return;
      var np=byMa[p.MaNV]; if(!np || !laCotPC(np) || np.CoDinh==='Có' || camXep(np._ma,csX.MaCS,'Pha chế')) return;
      var cp=caMap[p.MaCa]; if(cp._blocks.indexOf(blk)<0 || !caForStore(cp,csX.MaCS)) return;
      var csY=csMap[p.MaCS]; if(!cp._blocks.every(function(b){ return coCot(csY.MaCS,d,b)>=2; })) return;
      plan.forEach(function(q){
        if(q.Ngay!==d || q.MaCS!==csX.MaCS || !laPC(q) || !motCaTrongNgay(q)) return;
        var nq=byMa[q.MaNV]; if(!nq || laCotPC(nq) || nq.CoDinh==='Có' || camXep(nq._ma,csY.MaCS,'Pha chế')) return;
        var cq=caMap[q.MaCa]; if(!caForStore(cq,csY.MaCS)) return;
        // khối nào một bên mất người (giờ ca hai người khác nhau) thì quán đó vẫn phải đủ mức tối thiểu pha chế ở khối đó
        if(cq._blocks.indexOf(blk)<0 && cp._blocks.indexOf(blk)<0) return;
        var okX=cq._blocks.every(function(b){ return cp._blocks.indexOf(b)>-1 || covered(csX.MaCS,d,b,'Pha chế').length-1>=minNeed(csX,b,'Pha chế'); });
        var okY=cp._blocks.every(function(b){ return cq._blocks.indexOf(b)>-1 || covered(csY.MaCS,d,b,'Pha chế').length-1>=minNeed(csY,b,'Pha chế'); });
        if(!okX || !okY) return;
        if(!conQL(csY.MaCS,d,p,q) || !conQL(csX.MaCS,d,q,p)) return;
        var sc=(np._cs[csX.MaCS]||0)*3 + (nq._cs[csY.MaCS]||0)*3 + (q._mau?-1:0) + (p._mau?-1:0);
        if(sc>bs){ bs=sc; best={p:p,q:q,Y:csY.MaCS}; }
      });
    });
    if(!best) return false;
    var p=best.p, q=best.q, X=csX.MaCS, Y=best.Y, gp=+caMap[p.MaCa].SoGio||0, gq=+caMap[q.MaCa].SoGio||0;
    S[p.MaNV].storeHours[Y]-=gp; S[p.MaNV].storeHours[X]=(S[p.MaNV].storeHours[X]||0)+gp;
    S[q.MaNV].storeHours[X]-=gq; S[q.MaNV].storeHours[Y]=(S[q.MaNV].storeHours[Y]||0)+gq;
    p.MaCS=X; q.MaCS=Y;
    p.GhiChu=(p.GhiChu?p.GhiChu+' · ':'')+'Hoán đổi với '+tenNgan(byMa[q.MaNV])+' (cốt cán sang '+X+')';
    q.GhiChu=(q.GhiChu?q.GhiChu+' · ':'')+'Hoán đổi với '+tenNgan(byMa[p.MaNV])+' (sang '+Y+')';
    hoanDoiLog.push(d.slice(8,10)+'/'+(+d.slice(5,7))+' '+blk.toLowerCase()+': '+tenNgan(byMa[p.MaNV])+' '+Y+'→'+X+', '+tenNgan(byMa[q.MaNV])+' '+X+'→'+Y);
    return true;
  }
  if(String(cfg('TOI_UU_HOAN_DOI')||'Có')!=='Không'){
    var vHD=0, coHD=true;
    while(coHD && vHD++<4){ coHD=false;
      days.forEach(function(d){ stores.forEach(function(cs){ ['Sáng','Trưa','Tối'].forEach(function(b){
        if(!storeOpenBlock(cs,b) || coCot(cs.MaCS,d,b)>0) return;
        if(hoanDoiCot(cs,d,b)) coHD=true; }); }); });
    }
  }

  // ---------- gợi ý lấp chỗ thiếu: nới ràng buộc giờ/ngày/OFF, ưu tiên người hay làm & tăng ca được ----------
  function eligible(n, cs, blk, pos){
    if(pos==='Trưởng ca/QL') return isLeader(n);
    if(['Bảo vệ','Rửa ly'].indexOf(n.ViTri)>-1 && n._pos.indexOf(pos)<0) return false;
    if(n.CoDinh==='Có' && n.CoSoChinh!==cs.MaCS) return false;
    if(n.ViTri==='Bảo vệ' && (blk!=='Sáng' || n.CoSoChinh!==cs.MaCS)) return false;
    if(n._pos.indexOf(pos)>-1) return true;
    if(toMin(cs.GioDong)<=1110 && ['Pha chế','Phục vụ','Thu ngân'].indexOf(n.ViTri)>-1 && ['Pha chế','Phục vụ','Thu ngân'].indexOf(pos)>-1) return true;
    if(n.ViTri==='Thu ngân' && ['Pha chế','Phục vụ'].indexOf(pos)>-1) return true;
    return n._ft && n.TrangThai!=='Thử việc' && ['Phục vụ','Pha chế','Thu ngân'].indexOf(n.ViTri)>-1 && blk!=='Sáng' && ['Thu ngân','Pha chế'].indexOf(pos)>-1;
  }
  var BLOCK_CODES={'Sáng':['FT1','FT12','PT1'],'Trưa':['FT4','PT4','PT2'],'Tối':['FT2','PT3']};
  function suggestFor(g){
    var cs=csMap[g.MaCS], d=g.Ngay, blk=g.Khoi, list=[];
    nvs.forEach(function(n){
      var ma=n._ma, st=S[ma];
      if(!eligible(n,cs,blk,g.ViTri) || busy(ma,d,blk)) return;
      var today=st.days[d]||[], reason='', type='them', code=null, thay='';
      if(today.length){
        if(n.TangCaDuoc!=='Có') return;
        if(!n._ft && gayChiFT.indexOf(cs.MaCS)>-1) return;
        var a=today[0], ca=caMap[a.MaCa];
        if(blk==='Trưa' && a.MaCS===cs.MaCS && ca._blocks.indexOf('Sáng')>-1 && ca._blocks.indexOf('Trưa')<0){
          code=kieuCaCo(n._tq.KieuCa,'11,5')?'FT11':'FT10'; if(!caForStore(caMap[code],cs.MaCS)) return;
          type='keodai'; thay=a.MaCa; reason='Đang làm '+ca.TenCa+' tại '+a.MaCS+', kéo dài thành '+String(caMap[code].SoGio).replace('.',',')+'h';
        } else {
          if(today.length>1 || (a.MaCS!==cs.MaCS && !haiQuan)) return;     // đã gãy rồi; quán khác chỉ khi cho phép 2 quán/ngày
          code=(BLOCK_CODES[blk]||[]).filter(function(k){ var c=caMap[k]; return c && caForStore(c,cs.MaCS) && !overlaps(ma,d,c) && (n._ft || k.indexOf('PT')===0); })[0];
          if(!code) return;
          type='gay'; reason='Đang làm '+ca.TenCa+' tại '+a.MaCS+', thêm ca gãy';
        }
      } else {
        code=shiftFor(n,cs,blk); if(!caMap[code] || !caForStore(caMap[code],cs.MaCS)) return;
        var lim=capOf(n), dl=n._dmax;
        if(off[ma]===d) reason='Ngày OFF – hỏi đổi ngày nghỉ';
        else if(daysWorked(ma)>=dl) reason='Đã đủ '+dl+' ngày – làm thêm ngày 7';
        else if(st.hours+(+caMap[code].SoGio)>lim) reason='Đã '+st.hours+'h/tuần (thường '+lim+'h) – cần duyệt tăng ca';
        else reason='Còn trống';
        if(n.TangCaDuoc!=='Có' && reason!=='Còn trống') return;
      }
      if(st.hours+(+caMap[code].SoGio)-(thay?(+caMap[thay].SoGio):0) > Math.max(capOf(n),N.FTmax)+8) return;
      var sc=score(n,cs,d,blk,g.ViTri==='Trưởng ca/QL'?n.ViTri:g.ViTri) + (n.TangCaDuoc==='Có'?2:0) + (kieuCaCo(n._tq.KieuCa,'10,5')||kieuCaCo(n._tq.KieuCa,'gãy')?1:0) - (reason.indexOf('OFF')>-1?1:0);
      list.push({MaNV:ma, Ten:tenNgan(n), MaCa:code, ThayCa:thay, Loai:type, LyDo:reason, Gio:Math.round(st.hours*10)/10, sc:sc});
    });
    list.sort(function(a,b){return b.sc-a.sc;});
    return list.slice(0,3).map(function(x){ delete x.sc; return x; });
  }
  chuaCot=[]; days.forEach(function(d){ stores.forEach(function(cs){ ['Sáng','Trưa','Tối'].forEach(function(b){ if(storeOpenBlock(cs,b)) chuaCot.push({Ngay:d,MaCS:cs.MaCS,Khoi:b}); }); }); });
  var daGhi={}; chuaCot.forEach(function(x){ var kk=x.Ngay+x.MaCS+x.Khoi; if(!daGhi[kk] && !coCot(x.MaCS,x.Ngay,x.Khoi)){ daGhi[kk]=1; gaps.push({Ngay:x.Ngay,MaCS:x.MaCS,Khoi:x.Khoi,ViTri:'Pha chế lâu năm',Thieu:1,Muc:'nen'}); } });
  var goiYThieu=gaps.map(function(g){ return {Ngay:g.Ngay, MaCS:g.MaCS, Khoi:g.Khoi, ViTri:g.ViTri, Thieu:g.Thieu, Muc:g.Muc||'thieu', GoiY:suggestFor(g)}; })
    .sort(function(a,b){ return (a.Muc==='thieu'?0:1)-(b.Muc==='thieu'?0:1) || (a.Ngay<b.Ngay?-1:1); });

  if(p.duThao){ try{ damBaoPCCuoiNgay_(days, plan, caMap, byMa, stores); }catch(e){} }   // bản "xếp mới" (so sánh) cũng phải có pha chế tới lúc đóng quán
  if(p.duThao) return {ok:true, plan:plan, off:off, gaps:gaps, days:days,
    soThieu:gaps.filter(function(g){return g.Muc==='thieu';}).reduce(function(a,g){return a+g.Thieu;},0)};
  try{ damBaoPCCuoiNgay_(days, plan, caMap, byMa, stores); }catch(e){}
  try{ luuNhap(days, plan); }catch(e){}
  // (28/10) App xếp chỉ là BẢN GỢI Ý: không ghi đè lịch chính thức. Lịch chính thức chỉ đổi khi admin bấm "Áp dụng" (apDungLichQuan).
  var chiNhap=String(cfg('XEP_GHI_THANG')||'Không')!=='Có';
  if(!chiNhap){ var out=keep.concat(plan.map(function(a){return [a.Ngay,a.MaCS,a.MaNV,a.MaCa,a.ViTri,a.GhiChu||''];}));
    if(lichSh.getLastRow()>1) lichSh.getRange(2,1,lichSh.getLastRow()-1,lh.length).clearContent();
    if(out.length) lichSh.getRange(2,1,out.length,6).setValues(out.map(function(r){return r.slice(0,6);})); }

  // lưu ngày OFF của tuần (chỉ khi ghi thẳng lịch chính thức)
  if(!chiNhap){
  var nt=SS.getSheetByName('NghiTuan'), ntv=nt.getDataRange().getValues(), nth=ntv.shift();
  var ntKeep=ntv.filter(function(r){ return r[0]!=='' && dateKey(r[0])!==days[0]; }).concat(Object.keys(off).map(function(m){ return [days[0], m, off[m]]; }));
  if(nt.getLastRow()>1) nt.getRange(2,1,nt.getLastRow()-1,3).clearContent();
  if(ntKeep.length) nt.getRange(2,1,ntKeep.length,3).setValues(ntKeep);
  }
  // (28/10) bản gợi ý ghi vào BẢN NHÁP WEB (sửa như Google Sheet trong app); muốn sửa trên Sheet thì bấm "Xuất ra Google Sheet"
  var goiYFile=[], tenGoiY='Gợi ý '+days[0].slice(8,10)+'.'+days[0].slice(5,7), nhapWeb=false;
  try{ luuNhapMoi_(days[0], luoiTuKeHoach_(days, stores, plan, gaps, off, byMa, caMap), 'App', 'app xếp gợi ý ('+mode+')'); nhapWeb=true; }catch(e){ goiYFile.push({ten:'Bản nháp web', loi:String(e.message||e)}); }

  // bảng lịch dễ nhìn + gợi ý
  var tabList=writeStoreGrids(days, stores, plan, gaps, off, byMa, caMap, dm), tabName=tabList.join(', ');
  var tabNV=writePersonGrid(days, nvs, plan, off, ban, goiYThieu, caMap, csMap, S);
  var goiY=buildAdvice(days, stores, plan, gaps, ext, byMa, caMap, S, N);
  goiY.tuyen=goiYTuyen(gaps, stores, days);
  var tuyenCS=stores.slice().sort(function(a,b){ var o=['TP','DD','TD','TNV','LDD']; return o.indexOf(a.MaCS)-o.indexOf(b.MaCS); }).map(function(cs){
    var th=gaps.filter(function(g){return g.MaCS===cs.MaCS&&g.Muc==='thieu';}).reduce(function(a,g){return a+g.Thieu;},0);
    var nen=gaps.filter(function(g){return g.MaCS===cs.MaCS&&g.Muc!=='thieu';}).reduce(function(a,g){return a+g.Thieu;},0);
    var hires=goiY.tuyen.filter(function(t){return t.MaCS===cs.MaCS && !t.le;}), le=goiY.tuyen.filter(function(t){return t.MaCS===cs.MaCS && t.le;});
    var ct=hires.map(function(t){return '1 '+t.ViTri.toLowerCase()+' '+t.Loai+' ('+t.Luot+' ca)';});
    le.forEach(function(t){ ct.push('lẻ '+t.Luot+' ca '+t.ViTri.toLowerCase()+' '+t.Ngay+': '+(String(cfg('SUPPORT_CO_SO')||'TNV').indexOf(cs.MaCS)>-1?'người nhà / tăng ca':'tăng ca / chủ quán')); });
    return {MaCS:cs.MaCS, Ten:cs.TenCS, Thieu:th, Nen:nen, Tuyen:hires.length, ChiTiet:ct.join('; ')||'Đủ người'};
  });
  try{ writeHireSheet(days, tuyenCS); }catch(e){}
  writeSuggest(days[0], goiYThieu, caMap);
  // LỊCH GỢI Ý XẾP MỚI: song song với lịch chính (theo lịch cũ), app tự xếp lại từ đầu theo thuật toán để so sánh; không ghi đè lịch chính
  var goiYMoi=null;
  if(mode==='mau'){ try{ goiYMoi=luuGoiYMoi(p.pin, days, stores, byMa, caMap); }catch(e){ goiYMoi={loi:String(e)}; } }
  return {ok:true, banGoiY:chiNhap, nhapWeb:nhapWeb, goiYFile:goiYFile, tenGoiY:tenGoiY, catDu:catDu, hoanDoi:hoanDoiLog, doiOff:doiOffLog, goiYMoi:goiYMoi, nguonMau:nguonMau, tuyenCS:tuyenCS, fileUrl:lichFile().getUrl(), goiYThieu:goiYThieu, tab:tabName, tabNV:tabNV, soCa:plan.length, support:supportUsed.map(function(a){ return (byMa[a.MaNV]?byMa[a.MaNV].Ten:a.MaNV)+' – '+a.Ngay+' '+a.MaCS+' '+a.ViTri; }), soThieu:gaps.filter(function(g){return g.Muc==='thieu';}).reduce(function(a,g){return a+g.Thieu;},0), soNen:gaps.filter(function(g){return g.Muc!=='thieu';}).reduce(function(a,g){return a+g.Thieu;},0), gaps:goiY.gapSummary, tangCa:ext.filter(function(e){return e;}).map(function(e){return (byMa[e.MaNV]?byMa[e.MaNV].Ten:e.MaNV)+' '+e.Ngay+' '+e.MaCS+' – '+(e.GhiChu||'');}), tuyen:goiY.tuyen, gioTuan:goiY.gioTuan, coSo:goiY.coSo};
}

/* ---------- Bảng lịch tuần ĐÚNG MẪU ĐANG DÙNG ----------
   Tab "Lich_<thứ 2>": trái = LỊCH PHỤC VỤ (A–H), phải = LỊCH PHA CHẾ (J–Q); khối SÁNG / TRƯA / TỐI / OFF;
   trong mỗi khối, từng cơ sở một màu như lịch cũ: Trần Phú trắng, Tản Đà vàng, Đống Đa xanh lá, TNV xanh dương,
   hàng đỏ = quản lý / trưởng ca; ô "Tên (giờ)", "Tên gãy", "Tên full". Tab "LDD_<thứ 2>" theo mẫu LĐD (QL / TN / PC / PV).
   Dòng "THIẾU" đỏ nhạt ghi "Thiếu 1 pha chế – tăng ca thêm / chủ quán". */
var OLD_COLOR={TP:'#FFFFFF',TD:'#FFE599',DD:'#B6D7A8',TNV:'#C9DAF8'};
var LEAD_RED='#EA9999', GAP_RED='#F4CCCC', OFF_ORANGE='#FF9900', TITLE_GREEN='#38761D';
// Chữ trong ô – ĐÚNG KIỂU QUÁN GHI, đọc lại ra đúng giờ:
//   ca bắt đầu đầu buổi (sáng 06:30, trưa 12:00) hoặc ca tối kết thúc lúc đóng quán → "Tên (số giờ)";
//   ca lệch giờ → "Tên (10h30-6h30)"; ca full (06:30 tới đóng quán) → "Tên full"; ca gãy → kèm số giờ + "gãy".
function gioQuanDong_(cs){ return {TD:'18:30',TNV:'18:30'}[cs]||'22:30'; }
function mocChu_(p){ var h=Math.floor(p/60), m=p%60; return (h>12?h-12:h)+'h'+(m?('0'+m).slice(-2):''); }
function cellText(a, n, c){
  var nm=n?tenNgan(n):a.MaNV, g=a.GhiChu||'';
  if(/Support/.test(g)) return nm+' (support)';
  var bd=toMin(c.GioBD), kt=toMin(c.GioKT), dong=toMin(gioQuanDong_(a.MaCS)), blk=dispBlock(c), h=String(Math.round((kt-bd)/60*100)/100).replace('.',',');
  var dauBuoi=(blk==='Sáng' && bd===390) || (blk==='Trưa' && bd===720) || (blk==='Tối' && kt===dong);
  var t=(bd===390 && kt===dong && dong<=1110 && !/gãy/.test(g)) ? nm+' full' : (dauBuoi ? nm+' ('+h+')' : nm+' ('+mocChu_(bd)+'-'+mocChu_(kt)+')');
  if(/gãy/.test(g)) t+=' gãy';
  if(/Tăng ca|Lấp thiếu/.test(g)) t+=' TC';
  return t;
}
// dòng "làm tiếp qua trưa": chỉ ghi tên (như "Thư full" rồi "Thư" ở file quán) – đọc lại tự nối liền
function cellTextNoi(a, n){ return n?tenNgan(n):a.MaNV; }
function writeWeekSheet(days, stores, plan, gaps, off, byMa, caMap, tenTab, ssDich){
  var ss=ssDich||lichFile(), name=tenTab||('Lịch '+weekTag(days[0])), sh=ss.getSheetByName(name); if(sh) sh.clear(); else sh=ss.insertSheet(name,1);
  var DN=['Chủ nhật','Thứ 2','Thứ 3','Thứ 4','Thứ 5','Thứ 6','Thứ 7'], daNhanPC={};
  var out=[], bg=[], bold=[], fc=[], meta=[];
  function blank(){ var r=[]; for(var i=0;i<17;i++) r.push(''); return r; }
  function push(r,color,b,f,m){ while(r.length<17) r.push(''); out.push(r); bg.push(color||blank().map(function(){return null;})); bold.push(!!b); fc.push(f||null); meta.push(m||''); }
  var title=days[0].slice(8,10)+'/'+(+days[0].slice(5,7))+' - '+days[6].slice(8,10)+'/'+(+days[6].slice(5,7));
  var c1=blank().map(function(){return null;}); for(var i=0;i<8;i++) c1[i]=TITLE_GREEN; for(i=9;i<17;i++) c1[i]=TITLE_GREEN;
  var r=blank(); r[0]='LỊCH PHỤC VỤ  '+title; r[9]='LỊCH PHA CHẾ '+title; push(r,c1,true,'#FFFFFF','WEEK|'+days[0]);
  r=blank(); days.forEach(function(d,i){ r[1+i]=DN[dowOf(d)]; r[10+i]=DN[dowOf(d)]; }); push(r,null,true);
  r=blank(); days.forEach(function(d,i){ r[1+i]=new Date(d+'T12:00:00+07:00'); r[10+i]=r[1+i]; }); push(r,null,true,null,'NGAY');
  var old4=stores.filter(function(cs){return cs.MaCS!=='LDD';}).sort(function(a,b){ var o=['TP','TD','DD','TNV']; return o.indexOf(a.MaCS)-o.indexOf(b.MaCS); });
  var blocks=[['Sáng','SÁNG (6h30-12h)'],['Trưa','TRƯA (12h-17h)'],['Tối','TỐI (17h-22h30)']];
  function sideOf(a){ var n=byMa[a.MaNV]; var v=a.ViTri; if(v==='Phục vụ'||v==='Bảo vệ') return 'PV'; return 'PC'; } // pha chế, thu ngân, quản lý, rửa ly ở bảng pha chế (như lịch cũ)
  blocks.forEach(function(bk){
    var blk=bk[0], first=true;
    old4.forEach(function(cs){
      if(!storeOpenBlock(cs,blk)) return;
      ['PV','PC'].forEach(function(side){
        var off0=side==='PV'?1:10;
        if(blk==='Trưa'){   // người làm từ ca sáng kéo qua trưa (ca 8h đến 14h30, ca 10,5h đến 17h): ghi tên như lịch cũ, chỉ để xem
          var cont=days.map(function(d){ return plan.filter(function(a){ var c=caMap[a.MaCa]; return a.MaCS===cs.MaCS && a.Ngay===d && dispBlock(c)==='Sáng' && c._blocks.indexOf('Trưa')>-1 && sideOf(a)===side; }); });
          var nc=Math.max.apply(null,cont.map(function(x){return x.length;}));
          for(var ci2=0;ci2<nc;ci2++){ var rowc=blank(); days.forEach(function(d,di){ var a=cont[di][ci2]; if(a) rowc[off0+di]=cellTextNoi(a,byMa[a.MaNV]); });
            if(first && side==='PV'){ rowc[0]=bk[1]; first=false; } if(side==='PC' && !daNhanPC[blk]){ rowc[9]=bk[1]; daNhanPC[blk]=1; }
            var lead2=cont.some(function(x){ var a=x[ci2]; return a && byMa[a.MaNV] && isLeader(byMa[a.MaNV]); });
            push(rowc, blank().map(function(_,ci){ return (ci>=off0&&ci<off0+7)?OLD_COLOR[cs.MaCS]:null; }), false, null, 'CONT'); }
        }
        var ents=days.map(function(d){ return plan.filter(function(a){ var c=caMap[a.MaCa]; return a.MaCS===cs.MaCS && a.Ngay===d && dispBlock(c)===blk && sideOf(a)===side; })
          .sort(function(a,b){ var la=byMa[a.MaNV]&&isLeader(byMa[a.MaNV])?0:1, lb=byMa[b.MaNV]&&isLeader(byMa[b.MaNV])?0:1; return la-lb; }); });
        var leads=days.map(function(d,i){ return ents[i].filter(function(a){return byMa[a.MaNV]&&isLeader(byMa[a.MaNV]);}); });
        var rest=days.map(function(d,i){ return ents[i].filter(function(a){return !(byMa[a.MaNV]&&isLeader(byMa[a.MaNV]));}); });
        var nl=Math.max.apply(null,leads.map(function(x){return x.length;})), nr=Math.max.apply(null,rest.map(function(x){return x.length;}));
        if(side==='PC' && blk==='Sáng') nl=Math.max(nl,1);           // bảng pha chế: luôn có hàng đỏ QL/trưởng ca ở ca sáng
        if(nr===0 && nl===0 && !(blk==='Sáng')) return;
        nr=Math.max(nr,1)+1;   // chừa 1 dòng trống để quản lý điền thêm
        // hàng đỏ quản lý / trưởng ca
        for(var i=0;i<nl;i++){ var rr=out[out.length-1]; var row=(side==='PV')?blank():out[out.length-1].slice(); 
          // ghép 2 bên vào cùng dòng khi có thể: đơn giản hoá — mỗi bên viết dòng riêng, cột bên kia để trống
          row=blank(); days.forEach(function(d,di){ var a=leads[di][i]; if(a) row[off0+di]=cellText(a,byMa[a.MaNV],caMap[a.MaCa]); });
          if(first && side==='PV'){ row[0]=bk[1]; first=false; } if(side==='PC' && !daNhanPC[blk]){ row[9]=bk[1]; daNhanPC[blk]=1; }
          var col=blank().map(function(_,ci){ return (ci>=off0&&ci<off0+7)?OLD_COLOR[cs.MaCS]:null; }); push(row,col,true,null,cs.MaCS+'|'+blk+'|'+side+'|L');   // màu quán (đọc lại biết đúng quán), chữ đậm = trưởng ca
        }
        for(i=0;i<nr;i++){ row=blank(); days.forEach(function(d,di){ var a=rest[di][i]; if(a) row[off0+di]=cellText(a,byMa[a.MaNV],caMap[a.MaCa]); });
          if(first && side==='PV'){ row[0]=bk[1]; first=false; } if(side==='PC' && !daNhanPC[blk]){ row[9]=bk[1]; daNhanPC[blk]=1; }
          col=blank().map(function(_,ci){ return (ci>=off0&&ci<off0+7)?OLD_COLOR[cs.MaCS]:null; }); push(row,col,false,null,cs.MaCS+'|'+blk+'|'+side+'|');
        }
      });
    });
    // dòng THIẾU của khối
    [['thieu','THIẾU',GAP_RED,' – tăng ca thêm/chủ quán'],['nen','NÊN THÊM','#EFEFEF',' (so với mức chuẩn, gợi ý tăng ca)']].forEach(function(lv){
    var th=blank(); var anyGap=false;
    days.forEach(function(d,di){ var g=gaps.filter(function(x){return x.MaCS!=='LDD'&&x.Ngay===d&&x.Khoi===blk&&(x.Muc||'thieu')===lv[0];});
      var pv=g.filter(function(x){return x.ViTri==='Phục vụ'||x.ViTri==='Bảo vệ';}), pc=g.filter(function(x){return !(x.ViTri==='Phục vụ'||x.ViTri==='Bảo vệ');});
      if(pv.length){ th[1+di]=pv.map(function(x){return x.MaCS+': '+(lv[0]==='thieu'?'thiếu ':'+')+x.Thieu+' '+x.ViTri.toLowerCase()+lv[3];}).join('\n'); anyGap=true; }
      if(pc.length){ th[10+di]=pc.map(function(x){return x.MaCS+': '+(lv[0]==='thieu'?'thiếu ':'+')+x.Thieu+' '+x.ViTri.toLowerCase()+lv[3];}).join('\n'); anyGap=true; } });
    if(anyGap){ th[0]=lv[1]; push(th,blank().map(function(_,ci){return (ci===0||(ci>=1&&ci<8)||(ci>=10&&ci<17))?lv[2]:null;}),lv[0]==='thieu',null,'GAP'); }
    });
    push(blank(),null,false);
  });
  // OFF
  var offPV=days.map(function(d){ return Object.keys(off).filter(function(m){ return off[m]===d && byMa[m] && byMa[m].CoSoChinh!=='LDD' && (byMa[m].ViTri==='Phục vụ'||byMa[m].ViTri==='Bảo vệ'); }).map(function(m){return tenNgan(byMa[m]);}); });
  var offPC=days.map(function(d){ return Object.keys(off).filter(function(m){ return off[m]===d && byMa[m] && byMa[m].CoSoChinh!=='LDD' && !(byMa[m].ViTri==='Phục vụ'||byMa[m].ViTri==='Bảo vệ'); }).map(function(m){return tenNgan(byMa[m]);}); });
  var nOff=Math.max(1, Math.max.apply(null, offPV.concat(offPC).map(function(x){return x.length;})));
  for(var i=0;i<nOff;i++){ r=blank(); if(i===0){ r[0]='OFF'; r[9]='OFF'; } days.forEach(function(d,di){ r[1+di]=offPV[di][i]||''; r[10+di]=offPC[di][i]||''; });
    push(r, blank().map(function(_,ci){ return (ci===0||ci===9)?OFF_ORANGE:null; }), i===0, null, 'OFF'); }
  push(blank(),null,false);
  // chú thích màu
  [['TD','Cs Tản Đà'],['DD','Cs Đống Đa'],['TNV','Cs Trưng Nữ Vương'],['TP','Cs Trần Phú']].forEach(function(x){ r=blank(); r[2]=x[1]; push(r, blank().map(function(_,ci){return ci===0?OLD_COLOR[x[0]]:null;}),false); });
  sh.getRange(1,1,out.length,17).setValues(out).setBackgrounds(bg).setFontFamily('Times New Roman').setHorizontalAlignment('center').setVerticalAlignment('middle').setWrap(true);
  bold.forEach(function(b,i){ if(b) sh.getRange(i+1,1,1,17).setFontWeight('bold'); if(fc[i]) sh.getRange(i+1,1,1,17).setFontColor(fc[i]); });
  sh.getRange(1,1,1,8).merge(); sh.getRange(1,10,1,8).merge();
  sh.getRange(1,18,out.length,1).setValues(meta.map(function(x){return [x];})); sh.hideColumns(18);
  sh.getRange(4,2,out.length-3,7).setBorder(true,true,true,true,true,true,'#999999',null); sh.getRange(4,11,out.length-3,7).setBorder(true,true,true,true,true,true,'#999999',null);
  sh.setColumnWidth(1,110); sh.setColumnWidth(9,20); sh.setColumnWidth(10,110);
  for(i=2;i<=8;i++) sh.setColumnWidth(i,118); for(i=11;i<=17;i++) sh.setColumnWidth(i,118);
  sh.setFrozenRows(3);
  return name;
}
function writeLddSheet(days, plan, gaps, off, byMa, caMap, tenTab, ssDich){
  var ss=ssDich||lichFile(), name=tenTab||('LĐD '+weekTag(days[0])), sh=ss.getSheetByName(name); if(sh) sh.clear(); else sh=ss.insertSheet(name,2);
  var DN=['CN','Thứ 2','Thứ 3','Thứ 4','Thứ 5','Thứ 6','Thứ 7'], out=[], bg=[], bold=[], meta=[];
  function blank(){ return ['','','','','','','','','']; }
  function push(r,color,b,m){ out.push(r); bg.push(color||blank().map(function(){return null;})); bold.push(!!b); meta.push(m||''); }
  var r=blank(); r[0]='LỊCH LÊ ĐÌNH DƯƠNG '+days[0].slice(8,10)+'/'+(+days[0].slice(5,7))+' - '+days[6].slice(8,10)+'/'+(+days[6].slice(5,7)); push(r,blank().map(function(){return TITLE_GREEN;}),true,'WEEK|'+days[0]);
  r=blank(); days.forEach(function(d,i){ r[2+i]=DN[dowOf(d)]; }); push(r,blank().map(function(){return '#D9EAD3';}),true);
  r=blank(); days.forEach(function(d,i){ r[2+i]=new Date(d+'T12:00:00+07:00'); }); push(r,null,true);   // ngày thật (giống file quán, đọc lại được)
  var POS=[['Quản lý','QL','#F4CCCC'],['Pha chế','PC (kiêm thu ngân)','#EA9999'],['Phục vụ','PV','#FFFFFF'],['Rửa ly','RL','#E6E6E6'],['Bảo vệ','BV','#E3D7F5']];
  [['Sáng','SÁNG (6h30-12h)'],['Trưa','TRƯA (12h-17h)'],['Tối','TỐI (17h-22h30)']].forEach(function(bk){
    var blk=bk[0], first=true;
    POS.forEach(function(p){
      if(blk==='Trưa'){   // người ca sáng làm qua trưa: ghi luôn vào ca trưa, đúng hàng vị trí
        var cont=days.map(function(d){ return plan.filter(function(a){ var c=caMap[a.MaCa], n=byMa[a.MaNV], pos=a.ViTri; if(n&&n.ChucVu==='Quản lý'&&p[0]==='Quản lý') pos='Quản lý';
          return a.MaCS==='LDD' && a.Ngay===d && dispBlock(c)==='Sáng' && c._blocks.indexOf('Trưa')>-1 && pos===p[0]; }); });
        var nc=Math.max.apply(null,cont.map(function(x){return x.length;}));
        for(var k=0;k<nc;k++){ r=blank(); if(first){ r[0]=bk[1]; first=false; } if(k===0) r[1]=p[1]; days.forEach(function(d,di){ var a=cont[di][k]; if(a) r[2+di]=cellTextNoi(a,byMa[a.MaNV]); });
          push(r, blank().map(function(_,ci){ return ci>=1?p[2]:null; }), false, 'CONT'); }
      }
      var ents=days.map(function(d){ return plan.filter(function(a){ var c=caMap[a.MaCa], n=byMa[a.MaNV]; var pos=a.ViTri; if(n&&isLeader(n)&&p[0]==='Quản lý'&&n.ChucVu==='Quản lý') pos='Quản lý';
        return a.MaCS==='LDD' && a.Ngay===d && dispBlock(c)===blk && pos===p[0]; }); });
      var n=Math.max.apply(null,ents.map(function(x){return x.length;}));
      if(n===0 && !(blk!=='Trưa' && (p[0]==='Pha chế'||p[0]==='Phục vụ'))) return;
      for(var i=0;i<Math.max(1,n)+1;i++){ r=blank(); if(first){ r[0]=bk[1]; first=false; } if(i===0) r[1]=p[1];
        days.forEach(function(d,di){ var a=ents[di][i]; if(a) r[2+di]=cellText(a,byMa[a.MaNV],caMap[a.MaCa]); });
        push(r, blank().map(function(_,ci){ return ci>=1?p[2]:null; }), p[0]==='Quản lý', 'LDD|'+blk+'|'+p[0]); }
    });
    [['thieu','THIẾU',GAP_RED,' – tăng ca thêm/chủ quán'],['nen','NÊN THÊM','#EFEFEF',' (so với mức chuẩn)']].forEach(function(lv){
    var th=blank(), any=false; days.forEach(function(d,di){ var g=gaps.filter(function(x){return x.MaCS==='LDD'&&x.Ngay===d&&x.Khoi===blk&&(x.Muc||'thieu')===lv[0];}); if(g.length){ th[2+di]=g.map(function(x){return (lv[0]==='thieu'?'Thiếu ':'+')+x.Thieu+' '+x.ViTri.toLowerCase()+lv[3];}).join('\n'); any=true; } });
    if(any){ th[1]=lv[1]; push(th, blank().map(function(_,ci){return ci>=1?lv[2]:null;}),lv[0]==='thieu','GAP'); } });
  });
  var offs=days.map(function(d){ return Object.keys(off).filter(function(m){ return off[m]===d && byMa[m] && byMa[m].CoSoChinh==='LDD'; }).map(function(m){return tenNgan(byMa[m]);}); });
  var nOff=Math.max(1,Math.max.apply(null,offs.map(function(x){return x.length;})));
  for(var i=0;i<nOff;i++){ r=blank(); if(i===0) r[0]='OFF'; days.forEach(function(d,di){ r[2+di]=offs[di][i]||''; }); push(r, blank().map(function(){return '#F9CB9C';}), i===0, 'OFF'); }
  sh.getRange(1,1,out.length,9).setValues(out).setBackgrounds(bg).setFontFamily('Times New Roman').setHorizontalAlignment('center').setVerticalAlignment('middle').setWrap(true);
  bold.forEach(function(b,i){ if(b) sh.getRange(i+1,1,1,9).setFontWeight('bold'); });
  sh.getRange(1,1).setFontColor('#FFFFFF'); sh.getRange(1,1,1,9).merge();
  sh.getRange(1,10,out.length,1).setValues(meta.map(function(x){return [x];})); sh.hideColumns(10);
  sh.getRange(4,3,out.length-3,7).setBorder(true,true,true,true,true,true,'#999999',null);
  sh.setColumnWidth(1,120); sh.setColumnWidth(2,50); for(i=3;i<=9;i++) sh.setColumnWidth(i,118);
  sh.setFrozenRows(3);
  return name;
}
function writeStoreGrids(days, stores, plan, gaps, off, byMa, caMap, dm){
  return [writeWeekSheet(days, stores, plan, gaps, off, byMa, caMap), writeLddSheet(days, plan, gaps, off, byMa, caMap)];
}

/* ================= FILE LỊCH RIÊNG ("Lịch tuần Ncafe") =================
   Lấy dữ liệu từ file chính, trình bày đúng mẫu lịch cũ để xem và sửa cho dễ. Quản lý sửa tên / giờ ngay trong ô
   ("Lam (5,5)", "Thư gãy", "Mẫn full", "Tên (8) TC" = tăng ca), rồi bấm "Lấy thay đổi từ file lịch" trên app để cập nhật về file chính.
   Chia sẻ file này cho quản lý; file chính (có lương) chỉ admin giữ. */
function weekTag(d0){ return d0.slice(8,10)+'.'+d0.slice(5,7)+'.'+d0.slice(2,4); }
function lichFile(){
  var id=cfg('LICH_FILE_ID'), f=null;
  if(id){ try{ f=SpreadsheetApp.openById(id); }catch(e){ f=null; } }
  if(!f){
    f=SpreadsheetApp.create('Lịch tuần Ncafe'); try{ f.setSpreadsheetTimeZone(TZ); }catch(e){}
    setCfg('LICH_FILE_ID', f.getId());
    var s0=f.getSheets()[0]; s0.setName('Hướng dẫn');
    s0.getRange(1,1,8,1).setValues([['LỊCH TUẦN NCAFE – xem và sửa lịch'],
      ['Mỗi tuần có 2 tab: "Lịch dd.mm.yy" (Phục vụ bên trái, Pha chế bên phải, 4 cơ sở cũ) và "LĐD dd.mm.yy".'],
      ['Sửa trực tiếp trong ô: đổi tên, đổi giờ trong ngoặc, ví dụ  Lam (5,5)   Thư gãy   Mẫn full   Linh (8) TC (TC = tăng ca).'],
      ['Thêm người: ghi vào dòng trống của đúng cơ sở, đúng khối. Xoá người: xoá chữ trong ô. Dòng OFF: ghi tên người nghỉ.'],
      ['Sửa xong vào app quản lý → tab Lịch tuần → bấm "Lấy thay đổi từ file lịch" để cập nhật vào lịch chính (chấm công dùng lịch chính).'],
      ['Không xoá cột ẩn bên phải (cột R ở tab Lịch, cột J ở tab LĐD): app dùng cột này để biết ô thuộc cơ sở, khối nào.'],
      ['Tab "Tuyển dd.mm.yy": số ca thiếu và số người nên tuyển của từng cơ sở trong tuần.'],
      ['Màu: Trần Phú trắng · Tản Đà vàng · Đống Đa xanh lá · TNV xanh dương · hàng đỏ = quản lý / trưởng ca · THIẾU đỏ nhạt · NÊN THÊM xám.']]);
    s0.getRange(1,1).setFontWeight('bold').setFontSize(14); s0.setColumnWidth(1,900);
  }
  return f;
}
