    if(r.Loai==='VAO'){ vao[m]=r; caCC[m]=(caCC[m]||0)+1; var vt=String(r.ViTriLam||''); if(vt==='Pha chế'||vt==='Thu ngân'||vt==='Quản lý') pcCC[m]=(pcCC[m]||0)+1; }
