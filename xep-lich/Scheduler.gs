var VER_SCHED='29/10e XL';
var DU_LIEU_VER='2026-10-21f';
// Ghi đè ThoiQuen (người có trong dữ liệu gốc) và DinhMuc bằng số liệu tính từ lịch thật 2026. Chạy 1 lần mỗi phiên bản dữ liệu.
function napDuLieuMau(){
  if(cfg('DU_LIEU_MAU')===DU_LIEU_VER) return false;
  var tq=SS.getSheetByName('ThoiQuen'), v=tq.getDataRange().getValues(), h=v[0], have={};
  var byCode={}; THOI_QUEN_KHOI_TAO.forEach(function(t){ byCode[String(t[0])]=t; });
  for(var i=1;i<v.length;i++){ var c=up(v[i][0]); if(byCode[c]){ tq.getRange(i+1,1,1,7).setValues([byCode[c].map(function(x){return x===undefined?'':x;})]); have[c]=1; } }
  THOI_QUEN_KHOI_TAO.forEach(function(t){ if(!have[String(t[0])]) tq.appendRow(t); });
  tq.getRange('A:A').setNumberFormat('@'); tq.getRange('D:D').setNumberFormat('@');
  var dm=SS.getSheetByName('DinhMuc'); ensureCols('DinhMuc',['CuoiTuan']);
  if(dm.getLastRow()>1) dm.getRange(2,1,dm.getLastRow()-1,dm.getLastColumn()).clearContent();
  dm.getRange(2,1,DINH_MUC_TU_LICH.length,7).setValues(DINH_MUC_TU_LICH);
  setCfg('THEO_LICH_CU','Không');   // chủ quán chốt 21/10: lịch cũ chỉ là khung, mức tối thiểu cứng luôn phải đủ
  setCfg('DU_LIEU_MAU',DU_LIEU_VER);
  return true;
}
function setupScheduler(){
  var sh=SS.getSheetByName('ThoiQuen') || SS.insertSheet('ThoiQuen');
  if(sh.getLastRow()===0){
    sh.getRange(1,1,1,7).setValues([['MaNV','CoSoHayLam','KhoiHayLam','KieuCa','NgayTuan','GioTuan','ThuHayLam']]);
    sh.getRange('A:A').setNumberFormat('@'); sh.getRange('D:D').setNumberFormat('@');
    sh.getRange(2,1,THOI_QUEN_KHOI_TAO.length,7).setValues(THOI_QUEN_KHOI_TAO);
    sh.setFrozenRows(1);
  } else {
    ensureCols('ThoiQuen',['GioTuan','ThuHayLam']);
    var v=sh.getDataRange().getValues(), h=v[0], gi=h.indexOf('GioTuan');
    for(var i=1;i<v.length;i++){ if(v[i][gi]===''){ var d=THOI_QUEN_KHOI_TAO.filter(function(t){return t[0]===String(v[i][0]);})[0]; if(d && d[5]!=='') sh.getRange(i+1,gi+1).setValue(d[5]); } }
  }
  [['NghiThang',['Thang','MaNV','SoNgayNghi','GhiChu']],['NghiTuan',['Tuan','MaNV','Ngay']]].forEach(function(t){
    var x=SS.getSheetByName(t[0]) || SS.insertSheet(t[0]); if(x.getLastRow()===0){ x.getRange(1,1,1,t[1].length).setValues([t[1]]); x.setFrozenRows(1); x.getRange('B:B').setNumberFormat('@'); } });
  var dk=SS.getSheetByName('DangKyBan') || SS.insertSheet('DangKyBan');
  if(dk.getLastRow()===0){ dk.getRange(1,1,1,4).setValues([['Ngay','MaNV','Khoi','GhiChu']]); dk.setFrozenRows(1); }
  SCHED_DEFAULTS.forEach(function(kv){ if(cfg(kv[0])==='') setCfg(kv[0],kv[1]); });
  // 4 chỗ cho người nhà hỗ trợ (đổi tên trong tab NhanVien); chỉ được xếp khi THIẾU thật
  var nvSh=SS.getSheetByName('NhanVien'), nvv=rows('NhanVien');
  if(!nvv.some(function(n){return n.TrangThai==='Support'||n.ViTri==='Support';})){
    var h=nvSh.getRange(1,1,1,nvSh.getLastColumn()).getValues()[0];
    [['601','Support 1'],['602','Support 2'],['603','Support 3'],['604','Support 4']].forEach(function(x){
      var r=h.map(function(){return '';}); r[h.indexOf('MaNV')]=x[0]; r[h.indexOf('Ten')]=x[1]; r[h.indexOf('ViTri')]='Support'; r[h.indexOf('ChucVu')]='Hỗ trợ';
      r[h.indexOf('ViTriKiem')]='Pha chế, Phục vụ'; r[h.indexOf('Loai')]='PT'; r[h.indexOf('TangCaDuoc')]='Có'; r[h.indexOf('TrangThai')]='Support'; r[h.indexOf('GhiChu')]='Người nhà, gọi khi thiếu';
      nvSh.appendRow(r); });
  }
  napDuLieuMau();
  // ca còn thiếu cho xếp lịch
  var cas=rows('Ca'), caSh=SS.getSheetByName('Ca');
  [['FT12','Full TĐ/TNV','06:30','18:30',12,'FT','TD,TNV']].forEach(function(c){ if(!cas.some(function(x){return x.MaCa===c[0];})) caSh.appendRow(c); });
  // Định mức tính từ lịch thật: ToiThieu = T9–10/2026, Chuan = T6–8, CaoDiem = T1–3, CuoiTuan = thêm cuối tuần. Chỉ thêm dòng còn thiếu.
  ensureCols('DinhMuc',['CuoiTuan']);
  var dm=rows('DinhMuc'), dmSh=SS.getSheetByName('DinhMuc');
  DINH_MUC_TU_LICH.forEach(function(r){ if(!dm.some(function(x){return x.MaCS===r[0]&&x.Ca===r[1]&&x.ViTri===r[2];})) dmSh.appendRow(r); });
  // thu ngân không còn là vị trí riêng (pha chế kiêm); bảo vệ không có ca tối: bỏ các dòng định mức cũ đó
  var dv=dmSh.getDataRange().getValues(); for(var i=dv.length-1;i>=1;i--){ if(dv[i][2]==='Thu ngân' || (dv[i][2]==='Bảo vệ' && dv[i][1]!=='Sáng')) dmSh.deleteRow(i+1); }
  var tqv=sh.getDataRange().getValues(), bvs={}; rows('NhanVien').forEach(function(n){ if(n.ViTri==='Bảo vệ') bvs[up(n.MaNV)]=1; });
  for(var j=1;j<tqv.length;j++){ if(bvs[up(tqv[j][0])] && String(tqv[j][2]).indexOf('Sáng:1')!==0) sh.getRange(j+1,3).setValue('Sáng:1'); }
}

/* ---------- tiện ích ---------- */
function parseW(s){ var o={}; String(s||'').split(',').forEach(function(p){ var kv=p.split(':'); if(kv[0].trim()) o[kv[0].trim()]=+kv[1]||1; }); return o; }
function kieuCaCo(s, k){ return String(s||'').indexOf(k)>-1; }   // '10,5' / '11,5' / 'gãy' / 'full'
function caBlocks(c){ var b=toMin(c.GioBD), e=toMin(c.GioKT), out=[];
  BLOCKS.forEach(function(k){ var r=BLOCK_MIN[k], ov=Math.min(e,r[1])-Math.max(b,r[0]); if(ov>=(r[1]-r[0])*0.5) out.push(k); }); return out; }
// Luôn tính tuần từ thứ 2 (chọn nhầm ngày giữa tuần thì tự lùi về thứ 2), tránh các lần xếp chồng lên nhau
function mondayOf(iso){ var d=new Date(String(iso).slice(0,10)+'T12:00:00+07:00'); return fmtDate(addDays(d, -((dowOf(String(iso).slice(0,10))+6)%7))); }
var _TN=null;
function tenNgan(n){
  if(!n) return '';
  if(!_TN){ _TN={}; var cnt={}, all=rows('NhanVien').filter(function(x){return x.TrangThai!=='Đã nghỉ';});
    all.forEach(function(x){ var k=normName(String(x.Ten).split(' (')[0]); cnt[k]=(cnt[k]||0)+1; });
    var used={}; all.forEach(function(x){ var t=String(x.Ten), sh=t.split(' (')[0].trim(), inner=(t.match(/\(([^)]*)\)/)||[])[1];
      var nm=sh; if(cnt[normName(sh)]>1){ nm=(inner && !cnt[normName(inner)])?inner.trim():sh+' '+x.MaNV; }
      if(used[normName(nm)]) nm=sh+' '+x.MaNV; used[normName(nm)]=1; _TN[up(x.MaNV)]=nm; }); }
  return _TN[up(n.MaNV)] || String(n.Ten).split(' (')[0];
}
function denGio(c){ return fmtCa(c.GioKT).replace(/^0/,'').replace(':00','h').replace(':','h'); }
function dispBlock(c){ var b=toMin(c.GioBD); return b<600?'Sáng':(b<840?'Trưa':'Tối'); }
function addDays(d,n){ var x=new Date(d.getTime()); x.setDate(x.getDate()+n); return x; }
function dowOf(iso){ var p=String(iso).slice(0,10).split('-'); return new Date(Date.UTC(+p[0],+p[1]-1,+p[2])).getUTCDay(); } // 0=CN – không phụ thuộc múi giờ của dự án
function storeOpenBlock(cs, blk){ var r=BLOCK_MIN[blk]; return toMin(cs.GioDong)-r[0] >= (r[1]-r[0])*0.5; }
function isLeader(nv){ return nv.ChucVu==='Quản lý'||nv.ChucVu==='Trưởng ca'; }
function positionsOf(nv){ var p=[nv.ViTri].concat(String(nv.ViTriKiem||'').split(',').map(function(x){return x.trim();})); return p.filter(function(x){return x;}); }

/* ---------- thuật toán chính ---------- */
function xepLich(p){
  var t0=new Date().getTime();
  try{ var r=xepLichLoi(p); if(r && typeof r==='object') r.thoiGian=Math.round((new Date().getTime()-t0)/1000); return guiDuoc(r); }
  catch(e){ return {ok:false, msg:'Lỗi khi xếp lịch: '+(e && e.message ? e.message : String(e))+(e && e.lineNumber ? ' (dòng '+e.lineNumber+(e.fileName?', file '+e.fileName:'')+')' : '')+'. Anh chụp màn hình dòng này gửi lại để sửa.'}; }
}
// đổi mọi giá trị ngày giờ / hàm thành chữ để trình duyệt nhận được (google.script.run không gửi được kiểu Date)
function guiDuoc(x){ if(x===null||x===undefined) return x; if(x instanceof Date) return fmtDate(x); if(Array.isArray(x)) return x.map(guiDuoc);
  if(typeof x==='object'){ var o={}; Object.keys(x).forEach(function(k){ if(k.charAt(0)==='_') return; var v=x[k]; if(typeof v==='function') return; o[k]=guiDuoc(v); }); return o; } return x; }
function xepLichLoi(p){
  if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'};
  if(!p.duThao){ try{ if(cfg('CHAM_CONG_SHEET_ID')) dongBoChamCong(); }catch(e){} try{ hocDangKyBan(); }catch(e){} }
  setupScheduler();
  var mode=p.mode==='bosung'?'bosung':(p.mode==='full'?'full':'mau');
  try{ napDuLieuMau(); }catch(e){}
  var start=new Date(mondayOf(p.tuan)+'T12:00:00+07:00'); if(isNaN(start)) return {ok:false,msg:'Ngày bắt đầu tuần không hợp lệ'};
  var days=[]; for(var i=0;i<7;i++) days.push(fmtDate(addDays(start,i)));
  var N={FTd:+cfg('FT_NGAY_TUAN')||6, FTh:+cfg('FT_GIO_TUAN')||60, FTmax:+cfg('FT_GIO_MAX')||72, PTh:+cfg('PT_GIO_MAX')||40, PTd:+cfg('PT_NGAY_TUAN')||6, rot:+cfg('LUAN_CHUYEN_TUAN')||3, wk:+cfg('CUOI_TUAN_THEM')||0};
  var gayChiFT=String(cfg('GAY_CHI_FT')||'LDD').split(',').map(function(x){return x.trim();});
  var caoDiem=String(cfg('THANG_CAO_DIEM')||'').split(',').map(function(x){return +x;}).indexOf(+days[0].slice(5,7))>-1;

  var nvAll=rows('NhanVien');
  var nvs=nvAll.filter(function(n){return !n.TrangThai || n.TrangThai==='Đang làm' || n.TrangThai==='Thử việc';});
  var supports=nvAll.filter(function(n){return n.TrangThai==='Support' || n.ViTri==='Support';}).map(function(n){ n._ma=up(n.MaNV); n._tq={}; n._cs={}; n._blk={}; n._wd={}; n._ft=false; n._pos=['Pha chế','Phục vụ']; return n; });   // người nhà hỗ trợ, chỉ dùng khi THIẾU thật
  var tq={}; rows('ThoiQuen').forEach(function(t){ tq[up(t.MaNV)]=t; });
  var cas=rows('Ca'), caMap={}; cas.forEach(function(c){ c._blocks=caBlocks(c); c._b=toMin(c.GioBD); c._e=toMin(c.GioKT); caMap[c.MaCa]=c; });
  var stores=rows('CoSo').sort(function(a,b){return (+b.DoanhThuTB||0)-(+a.DoanhThuTB||0);}), csMap={}; stores.forEach(function(s){csMap[s.MaCS]=s;});
  var maxRev=Math.max.apply(null, stores.map(function(s){return +s.DoanhThuTB||1;}));
  var dm=rows('DinhMuc'), ban=rows('DangKyBan').filter(function(b){return days.indexOf(dateKey(b.Ngay))>-1;});
  var lgs=nvs.map(function(n){return +n.LuongGio||0;}).filter(function(x){return x>0;}), lgMin=Math.min.apply(null,lgs.concat([1e9])), lgMax=Math.max.apply(null,lgs.concat([0]));

  // trạng thái từng người
  var S={}; supports.forEach(function(n){ S[n._ma]={hours:0,days:{},storeHours:{}}; });
  var KS=ksDocTatCa();
  nvs.forEach(function(n){ var ma=up(n.MaNV); n._ma=ma; n._pos=positionsOf(n); n._tq=tq[ma]||{}; n._cs=parseW(n._tq.CoSoHayLam||(n.CoSoChinh+':1')); n._blk=parseW(n._tq.KhoiHayLam||'Sáng:1'); n._wd=parseW(n._tq.ThuHayLam||''); n._ft=(n.Loai==='FT');
    // kinh nghiệm: từ lịch thật (số tháng, số ca) + chức vụ; có lương giờ thì cộng thêm
    var kn=knHoc(ma);
    n._tier = (isLeader(n) || (kn[0]>=6 && kn[1]>=150)) ? 'cot' : ((kn[0]>=3 || kn[1]>=80) ? 'tb' : 'moi');
    if(n.TrangThai==='Thử việc') n._tier='moi';
    var expKN = n._tier==='cot'?1:(n._tier==='tb'?0.6:0.2);
    n._exp = (lgMax>lgMin && +n.LuongGio>0) ? (expKN + (+n.LuongGio-lgMin)/(lgMax-lgMin))/2 : expKN;
    // khảo sát nhân viên + tập sự (anh chốt 23/10: phục vụ mới 4 ca đầu cần người kèm; pha chế mới 1–2 tuần đầu đứng cùng full time lâu năm)
    n._ks=(KS[ma]||{}).data||null;
    var ngayDau=kn[3] || (n._ks && n._ks.batDau ? n._ks.batDau+'-01' : ''), soNgay=ngayDau?(new Date().getTime()-new Date(ngayDau+'T12:00:00+07:00').getTime())/864e5:0;
    n._tapSu=null;
    if(n.ViTri==='Phục vụ' && kn[1]<4) n._tapSu='PV';
    if((n.ViTri==='Pha chế') && (kn[1]<10 || (ngayDau && soNgay<14) || (n._ks && n._ks.menu==='Mới vài món' && kn[1]<40))) n._tapSu='PC';
    if(!kn[1] && !ngayDau && n.TrangThai==='Thử việc') n._tapSu=(n.ViTri==='Pha chế'?'PC':(n.ViTri==='Phục vụ'?'PV':null));
    // phục vụ lâu năm đã từng đứng pha chế trong lịch cũ (≥ 10% số ca) thì xếp pha chế được
