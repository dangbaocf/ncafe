  var cham=function(k){ if(k==='Cả ngày') return true; var x=KH[k]; return x && a<x[1] && b>x[0]; };
  var r=rows('DangKyBan').filter(function(x){ return up(x.MaNV)===up(ma) && dateKey(x.Ngay)===ngay && cham(x.Khoi); })[0]; if(r) return 'đã đăng ký bận '+String(r.Khoi).toLowerCase()+' ngày này';
  var thu=['CN','T2','T3','T4','T5','T6','T7'][new Date(ngay+'T12:00:00+07:00').getUTCDay()];
