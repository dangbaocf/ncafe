/* ---------- Gợi ý tuyển: gom các lượt THIẾU thật thành số người cần tuyển ----------
   Một người full time 6h30–17h00 lấp được sáng + trưa cùng ngày (6 ngày/tuần); full time chiều 14h30–22h30 lấp trưa + tối;
   part time lấp 1 ca/ngày (5 ngày/tuần). Gom tham lam: mỗi lần tạo 1 "người ảo" lấp được nhiều lượt nhất. */
function goiYTuyen(gaps, stores, days){
  var th=gaps.filter(function(g){return g.Muc==='thieu' && ['Pha chế','Phục vụ','Rửa ly','Bảo vệ','Trưởng ca/QL'].indexOf(g.ViTri)>-1;});
  var out=[], csName={}; stores.forEach(function(s){csName[s.MaCS]=s.TenCS;});
  var DN=['CN','T2','T3','T4','T5','T6','T7'];
  var keys={}; th.forEach(function(g){ keys[g.MaCS+'|'+g.ViTri]=1; });
  Object.keys(keys).forEach(function(k){
    var cs=k.split('|')[0], pos=k.split('|')[1];
    var need={}; th.filter(function(g){return g.MaCS===cs&&g.ViTri===pos;}).forEach(function(g){ var kk=g.Ngay+'|'+g.Khoi; need[kk]=(need[kk]||0)+g.Thieu; });
    var guard=0;
    while(Object.keys(need).some(function(kk){return need[kk]>0;}) && guard++<20){
      var best=null;
      [['FT 6h30–17h00',['Sáng','Trưa'],6],['FT 14h30–22h30',['Trưa','Tối'],6],['PT sáng 6h30–12h',['Sáng'],5],['PT trưa 12h–17h',['Trưa'],5],['PT tối 17h–22h30',['Tối'],5],['PT cuối tuần (sáng + tối T7, CN)',['Sáng','Tối'],2,true]].forEach(function(t){
        var dayScore=days.filter(function(d){ return !t[3] || dowOf(d)===0 || dowOf(d)===6; }).map(function(d){ return {d:d, s:t[1].reduce(function(a,b){return a+((need[d+'|'+b]||0)>0?1:0);},0)}; }).filter(function(x){return x.s>0;}).sort(function(a,b){return b.s-a.s;}).slice(0,t[2]);
        var tot=dayScore.reduce(function(a,x){return a+x.s;},0);
        if(tot>0 && (!best || tot>best.tot || (tot===best.tot && t[2]<best.cap))) best={t:t,days:dayScore,tot:tot,cap:t[2]};
      });
      if(!best) break;
      best.days.forEach(function(x){ best.t[1].forEach(function(b){ if(need[x.d+'|'+b]>0) need[x.d+'|'+b]--; }); });
      var dlist=best.days.map(function(x){return DN[dowOf(x.d)];}).join(', ');
      if(best.tot<3){ // lượt lẻ: gom lại, không tuyển
        var le=Object.keys(need).reduce(function(a,kk){return a+need[kk];},0)+best.tot;
        var leDays=Object.keys(need).filter(function(kk){return need[kk]>0;}).map(function(kk){return DN[dowOf(kk.split('|')[0])];}).concat(best.days.map(function(x){return DN[dowOf(x.d)];}));
        leDays=leDays.filter(function(x,i){return leDays.indexOf(x)===i;});
        out.push({MaCS:cs, Ten:csName[cs]||cs, ViTri:pos, Loai:'', Luot:le, Ngay:leDays.join(', '), le:true,
          text:(csName[cs]||cs)+': còn thiếu lẻ '+le+' lượt '+pos.toLowerCase()+' ('+leDays.join(', ')+') – '+(String(cfg('SUPPORT_CO_SO')||'TNV').indexOf(cs)>-1?'nhờ người nhà / tăng ca':'tăng ca / chủ quán')+', chưa cần tuyển'}); break; }
      out.push({MaCS:cs, Ten:csName[cs]||cs, ViTri:pos, Loai:best.t[0], Luot:best.tot, Ngay:dlist,
        text:'Tuyển 1 '+pos.toLowerCase()+' '+best.t[0]+' cho '+(csName[cs]||cs)+' – lấp '+best.tot+' lượt ('+dlist+')'});
    }
  });
  return out;
}

/* ---------- Lịch mẫu: lấy tuần trước (trong app) hoặc lịch thật 19–25/10 làm khung, chỉ bổ sung chỗ dưới mức tối thiểu ---------- */
function seedRows(days, byMa, caMap, csMap){
  var prev=days.map(function(d){ return fmtDate(addDays(new Date(d+'T12:00:00+07:00'),-7)); });
  var lich=rows('LichLam').filter(function(l){ return prev.indexOf(dateKey(l.Ngay))>-1 && caMap[l.MaCa]; });
  var out=[];
  var nDays={}; lich.forEach(function(l){ nDays[dateKey(l.Ngay)]=1; });
  var du=true; prev.forEach(function(d){ Object.keys(csMap).forEach(function(cs){
      var n=lich.filter(function(l){ return dateKey(l.Ngay)===d && l.MaCS===cs && dispBlock(caMap[l.MaCa])==='Sáng'; }).length;
      if(n<2) du=false; }); });
  // tuần trước có ca nào quá đông bất thường (lịch lỗi của bản cũ) thì không dùng làm mẫu
  var dem={}; lich.forEach(function(l){ var k=dateKey(l.Ngay)+'|'+l.MaCS+'|'+dispBlock(caMap[l.MaCa]); dem[k]=(dem[k]||0)+1; });
  var phinh=Object.keys(dem).some(function(k){ return dem[k]>14; });
  if(du && !phinh && lich.length>=100 && Object.keys(nDays).length>=6){   // tuần trước phải đủ 7 ngày, quán nào ca sáng cũng có người, mới dùng làm mẫu
    lich.forEach(function(l){ if(/Support/.test(l.GhiChu||'')) return; if(l.ViTri==='Bảo vệ' && dispBlock(caMap[l.MaCa])!=='Sáng') return; var i=prev.indexOf(dateKey(l.Ngay));
      out.push({Ngay:days[i],MaCS:l.MaCS,MaNV:up(l.MaNV),MaCa:l.MaCa,ViTri:l.ViTri,GhiChu:/gãy/.test(l.GhiChu||'')?'Ca gãy (như trước)':''}); });
    return {rows:out, nguon:'lịch tuần trước ('+prev[0].slice(8,10)+'/'+(+prev[0].slice(5,7))+')'};
  }
  var dayByDow={}; days.forEach(function(d){ dayByDow[dowOf(d)]=d; });
  var seen={}, coToi={};
  LICH_MAU.forEach(function(m){ if(m[3]==='Tối') coToi[m[0]+'|'+up(m[2])]=m[1]; });   // ai có ca tối ghi rõ (kể cả ở quán khác)
  LICH_MAU.forEach(function(m){
    var d=dayByDow[m[0]], cs=csMap[m[1]], nv=byMa[up(m[2])]; if(!d||!cs||!nv) return;
    if(m[6]==='Bảo vệ' && m[3]!=='Sáng') return;
    var key=d+'|'+up(m[2]), st=seen[key]||{rows:[],gayDone:false};
    var o={hours:m[4]===''?null:+m[4], gay:m[5]==='gãy', full:m[5]==='full'};
    if(o.gay && m[3]==='Sáng' && coToi[m[0]+'|'+up(m[2])]){ o.gay=false; if(o.hours===null) o.hours=5.5; }   // ca tối đã ghi riêng (có thể ở quán khác) → sáng vẫn là ca gãy ngắn 6h30–12h
    if(st.rows.length){
      if(m[3]==='Trưa' && st.rows.some(function(r){ return r.MaCS===m[1]; })) return;   // trưa cùng quán = người ca sáng làm tiếp
      if(m[3]==='Tối' && st.gayDone) return;
    }
    var codes=caFromText(o,m[3],cs,nv);
    codes.forEach(function(code,ci){
      var c=caMap[code]; if(!c) return;
      var clash=st.rows.some(function(r){ var x=caMap[r.MaCa]; return toMin(c.GioBD)<toMin(x.GioKT) && toMin(x.GioBD)<toMin(c.GioKT); });
      if(clash) return;
      var ghi=(st.rows.length || ci>0)?((st.rows.length && st.rows[0].MaCS!==m[1])?'Ca gãy 2 quán (như trước)':'Ca gãy (như trước)'):'';
      var a={Ngay:d,MaCS:m[1],MaNV:up(m[2]),MaCa:code,ViTri:m[6],GhiChu:ghi}; out.push(a); st.rows.push(a);
    });
    if(o.gay && m[3]==='Sáng') st.gayDone=true;
    seen[key]=st;
  });
  return {rows:out, nguon:'lịch thật tuần 19–25/10 + 8 tuần (31/8–25/10)'};
}

/* ---------- Nhân sự: quản lý thêm người mới, sửa, cho nghỉ việc (ngay trên app) ---------- */
var NHOM_MA={'Quản lý':100,'Pha chế':200,'Phục vụ':300,'Rửa ly':400,'Bảo vệ':500,'Support':600};
function dsNhanSu(p){
  var role=authRole(p.pin); if(!role) return {ok:false,msg:'Sai mã'};
  ensureCols('NhanVien',['NgayVao','NgayNghi']);
  var list=rows('NhanVien').map(function(n){ var o={MaNV:String(n.MaNV),Ten:n.Ten,ViTri:n.ViTri,ChucVu:n.ChucVu,ViTriKiem:n.ViTriKiem,Loai:n.Loai,CoSoChinh:n.CoSoChinh,TangCaDuoc:n.TangCaDuoc,SinhVien:n.SinhVien,CoDinh:n.CoDinh,SDT:String(n.SDT||''),TrangThai:n.TrangThai||'Đang làm',NgayVao:n.NgayVao?dateKey(n.NgayVao):'',NgayNghi:n.NgayNghi?dateKey(n.NgayNghi):'',GhiChu:n.GhiChu||''};
    if(role==='admin') o.LuongGio=n.LuongGio; return o; });
  return {ok:true, role:role, list:list};
}
function nvRowIndex(ma){ var sh=SS.getSheetByName('NhanVien'), v=sh.getDataRange().getValues(); for(var i=1;i<v.length;i++){ if(up(v[i][0])===up(ma)) return {sh:sh,h:v[0],i:i+1,row:v[i]}; } return null; }
var NV_FIELDS=['Ten','ViTri','ChucVu','ViTriKiem','Loai','CoSoChinh','TangCaDuoc','SinhVien','CoDinh','SDT','TrangThai','GhiChu','NgayVao'];
function themNhanSu(p){
  var role=authRole(p.pin); if(!role) return {ok:false,msg:'Sai mã'};
  var d=p.data||{}; if(!String(d.Ten||'').trim()) return {ok:false,msg:'Nhập tên'};
  if(!NHOM_MA[d.ViTri]) return {ok:false,msg:'Chọn vị trí'}; if(!d.CoSoChinh) return {ok:false,msg:'Chọn cơ sở chính'};
  ensureCols('NhanVien',['NgayVao','NgayNghi','LuongGio','SinhVien','CoDinh']);
  var list=rows('NhanVien');
  if(list.some(function(n){ return normName(String(n.Ten).split(' (')[0])===normName(String(d.Ten).split(' (')[0]) && n.TrangThai!=='Đã nghỉ'; }))
    return {ok:false,msg:'Đã có người tên "'+d.Ten+'" đang làm. Thêm chữ phân biệt, ví dụ "'+d.Ten+' 2" hoặc ghi họ tên trong ngoặc.'};
  var base=NHOM_MA[d.ViTri], max=base;
  list.forEach(function(n){ var m=+n.MaNV; if(m>base && m<base+100 && m>max) max=m; });
  var code=String(max+1);
  var sh=SS.getSheetByName('NhanVien'), h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0], r=h.map(function(){return '';});
  NV_FIELDS.forEach(function(f){ var i=h.indexOf(f); if(i>-1 && d[f]!==undefined) r[i]=d[f]; });
  r[h.indexOf('MaNV')]=code; if(!d.TrangThai) r[h.indexOf('TrangThai')]='Thử việc';
  if(h.indexOf('NgayVao')>-1 && !d.NgayVao) r[h.indexOf('NgayVao')]=fmtDate(new Date());
  if(!d.ChucVu) r[h.indexOf('ChucVu')]= d.ViTri==='Quản lý'?'Quản lý':'Nhân viên';
  if(role==='admin' && d.LuongGio!==undefined && h.indexOf('LuongGio')>-1) r[h.indexOf('LuongGio')]=d.LuongGio;
  sh.appendRow(r); sh.getRange(sh.getLastRow(),h.indexOf('MaNV')+1).setNumberFormat('@').setValue(code);
  // thói quen ban đầu: quán chính, ca chọn
  var tq=SS.getSheetByName('ThoiQuen'); if(tq){ var ft=d.Loai==='FT';
    tq.appendRow([code, d.CoSoChinh+':1', (d.CaUuTien||'Sáng')+':1', ft?'8':'5,5', ft?6:4, '', '']); tq.getRange(tq.getLastRow(),1).setNumberFormat('@').setValue(code); }
  return {ok:true, MaNV:code};
}
function suaNhanSu(p){
  var role=authRole(p.pin); if(!role) return {ok:false,msg:'Sai mã'};
  var f=nvRowIndex(p.maNV); if(!f) return {ok:false,msg:'Không tìm thấy mã '+p.maNV};
  var d=p.data||{};
  NV_FIELDS.forEach(function(k){ var i=f.h.indexOf(k); if(i>-1 && d[k]!==undefined) f.sh.getRange(f.i,i+1).setValue(d[k]); });
  if(role==='admin' && d.LuongGio!==undefined && f.h.indexOf('LuongGio')>-1) f.sh.getRange(f.i,f.h.indexOf('LuongGio')+1).setValue(d.LuongGio);
  if(d.CaUuTien || d.CoSoChinh){ var tq=SS.getSheetByName('ThoiQuen'), v=tq.getDataRange().getValues();
    for(var j=1;j<v.length;j++){ if(up(v[j][0])===up(p.maNV)){ if(d.CoSoChinh && String(v[j][1]).indexOf(d.CoSoChinh)<0) tq.getRange(j+1,2).setValue(d.CoSoChinh+':1'); if(d.CaUuTien) tq.getRange(j+1,3).setValue(d.CaUuTien+':1'); break; } } }
  return {ok:true};
}
function nghiViec(p){
  var role=authRole(p.pin); if(!role) return {ok:false,msg:'Sai mã'};
  ensureCols('NhanVien',['NgayVao','NgayNghi']);
  var f=nvRowIndex(p.maNV); if(!f) return {ok:false,msg:'Không tìm thấy mã '+p.maNV};
  var ngay=p.ngay||fmtDate(new Date());
  f.sh.getRange(f.i,f.h.indexOf('TrangThai')+1).setValue('Đã nghỉ');
  f.sh.getRange(f.i,f.h.indexOf('NgayNghi')+1).setValue(ngay);
  if(p.lyDo) f.sh.getRange(f.i,f.h.indexOf('GhiChu')+1).setValue(String(f.row[f.h.indexOf('GhiChu')]||'')+' | Nghỉ '+ngay+': '+p.lyDo);
  // bỏ các ca đã xếp từ ngày nghỉ trở đi
  var lock=LockService.getScriptLock(); lock.waitLock(20000); var removed=0;
  try{
    var sh=SS.getSheetByName('LichLam'), v=sh.getDataRange().getValues();
    for(var i=v.length-1;i>=1;i--){ if(up(v[i][2])===up(p.maNV) && dateKey(v[i][0])>=ngay){ sh.deleteRow(i+1); removed++; } }
  } finally { lock.releaseLock(); }
  return {ok:true, boCa:removed};
}

/* ================= LỊCH GỢI Ý XẾP MỚI ================= */
function luuGoiYMoi(pin, days, stores, byMa, caMap){
  var g=xepLich({pin:pin, tuan:days[0], mode:'full', duThao:true});
  var sh=SS.getSheetByName('GoiYMoi'); if(!sh){ sh=SS.insertSheet('GoiYMoi'); sh.getRange(1,1,1,7).setValues([['Tuan','Ngay','MaCS','MaNV','MaCa','ViTri','GhiChu']]); sh.getRange('D:D').setNumberFormat('@'); }
  var v=sh.getDataRange().getValues(), h=v.shift();
  var keep=v.filter(function(r){ return r[0]!=='' && dateKey(r[0])!==days[0]; });
  var rowsG=keep.concat(g.plan.map(function(a){ return [days[0],a.Ngay,a.MaCS,String(a.MaNV),a.MaCa,a.ViTri,a.GhiChu||'']; }));
  if(sh.getLastRow()>1) sh.getRange(2,1,sh.getLastRow()-1,7).clearContent();
  if(rowsG.length) sh.getRange(2,1,rowsG.length,7).setValues(rowsG);
  setCfg('GOIY_MOI_'+days[0], g.soThieu);
  try{ writeWeekSheet(days, stores, g.plan, g.gaps, g.off, byMa, caMap, 'Gợi ý mới '+weekTag(days[0])); writeLddSheet(days, g.plan, g.gaps, g.off, byMa, caMap, 'Gợi ý LĐD '+weekTag(days[0])); }catch(e){}
  return {soCa:g.plan.length, soThieu:g.soThieu};
}
// Dùng lịch gợi ý cho 1 cơ sở (hoặc cả tuần): thay ca của cơ sở đó trong lịch chính bằng ca gợi ý; ai đã có ca ở quán khác cùng ngày thì bỏ qua
function apDungGoiYMoi(p){   // (28/10) không ghi thẳng lịch chính thức: đưa lịch gợi ý xếp mới vào BẢN NHÁP để sửa → kiểm tra → áp dụng
  if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'};
  var d0=mondayOf(p.tuan), days=[]; for(var i=0;i<7;i++) days.push(fmtDate(addDays(new Date(d0+'T12:00:00+07:00'),i)));
  var g=(SS.getSheetByName('GoiYMoi')?rows('GoiYMoi'):[]).filter(function(r){ return dateKey(r.Tuan)===d0; });
  if(!g.length) return {ok:false,msg:'Chưa có lịch gợi ý xếp mới cho tuần này. Bấm "Gợi ý theo lịch tuần trước" ở tab Xếp lịch trước.'};
  var caMap={}; rows('Ca').forEach(function(c){ c._blocks=caBlocks(c); caMap[c.MaCa]=c; }); var byMa={}; rows('NhanVien').forEach(function(n){ byMa[up(n.MaNV)]=n; });
  var plan=g.filter(function(r){ return caMap[r.MaCa]; }).map(function(r){ return {Ngay:dateKey(r.Ngay), MaCS:r.MaCS, MaNV:up(r.MaNV), MaCa:r.MaCa, ViTri:r.ViTri, GhiChu:r.GhiChu||''}; });
  luuNhapMoi_(d0, luoiTuKeHoach_(days, rows('CoSo'), plan, [], {}, byMa, caMap), authRole(p.pin)==='admin'?'Admin':'Quản lý', 'lịch gợi ý xếp mới');
  return {ok:true, vaoNhap:true, so:plan.length, boQua:[]}; }
function ungVien(p){
  if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'};
  var d=p.ngay, cs=p.maCS, blk=p.khoi, side=p.side, d0=mondayOf(d), wk=[]; for(var i=0;i<7;i++) wk.push(fmtDate(addDays(new Date(d0+'T12:00:00+07:00'),i)));
  var cas={}; rows('Ca').forEach(function(c){cas[c.MaCa]=c;});
  var tq={}; rows('ThoiQuen').forEach(function(t){ tq[up(t.MaNV)]=t; });
  var lich=rows('LichLam').filter(function(l){ return wk.indexOf(dateKey(l.Ngay))>-1; });
  var off={}; rows('NghiTuan').forEach(function(r){ if(dateKey(r.Tuan)===d0 && dateKey(r.Ngay)===d) off[up(r.MaNV)]=1; });
  var ban={}; rows('DangKyBan').forEach(function(b){ if(dateKey(b.Ngay)===d && b.Khoi===blk) ban[up(b.MaNV)]=1; });
  function w(str,key){ var m=String(str||'').match(new RegExp(key+':([0-9.]+)')); return m?+m[1]:0; }
  var td=(cs==='TD'||cs==='TNV');
  var out=[];
  rows('NhanVien').forEach(function(n){
    var st=String(n.TrangThai||'Đang làm'); if(st==='Đã nghỉ'||st==='Nghỉ việc') return;
    var ma=up(n.MaNV), kiem=String(n.ViTriKiem||'');
    var hop = side==='PV' ? (n.ViTri==='Phục vụ'||/Phục vụ/.test(kiem)||(td&&n.ViTri!=='Bảo vệ'&&n.ViTri!=='Rửa ly')||n.ViTri==='Bảo vệ')
            : (n.ViTri==='Pha chế'||n.ViTri==='Quản lý'||/Pha chế|Thu ngân/.test(kiem)||n.ViTri==='Rửa ly'||(td&&n.ViTri==='Phục vụ'));
    if(!hop && st!=='Support') return;
    if(n.CoDinh==='Có' && n.CoSoChinh!==cs) return;
    if(n.ViTri==='Bảo vệ' && n.CoSoChinh!==cs) return;
    var mine=lich.filter(function(l){ return up(l.MaNV)===ma && dateKey(l.Ngay)===d; });
    var gio=lich.filter(function(l){ return up(l.MaNV)===ma; }).reduce(function(a,l){ return a+(cas[l.MaCa]?+cas[l.MaCa].SoGio:0); },0);
    var t=tq[ma]||{}, cap=+t.GioTuan||(n.Loai==='FT'?60:40);
    var dung = side==='PV' ? n.ViTri==='Phục vụ' : (n.ViTri==='Pha chế'||n.ViTri==='Quản lý');   // đúng vị trí chính
    var sc=w(t.CoSoHayLam,cs)*3 + w(t.KhoiHayLam,blk)*2 + (dung?2:0) + (n.Loai==='FT'?0.3:0) - gio/cap - (st==='Support'?5:0);
    var nhom='ranh', ghi=[];
    if(w(t.CoSoHayLam,cs)>0) ghi.push('hay làm '+cs+' '+Math.round(w(t.CoSoHayLam,cs)*100)+'%');
    if(w(t.KhoiHayLam,blk)>0) ghi.push('ca '+blk.toLowerCase()+' '+Math.round(w(t.KhoiHayLam,blk)*100)+'%');
    ghi.push(Math.round(gio*10)/10+'h/tuần');
    if(mine.length){ nhom='coCa'; ghi.unshift('đang làm '+mine.map(function(l){ return l.MaCS+' '+(cas[l.MaCa]?fmtCa(cas[l.MaCa].GioBD)+'–'+fmtCa(cas[l.MaCa].GioKT):l.MaCa); }).join(', ')); if(mine.some(function(l){return l.MaCS===cs;})) ghi.push('có thể gãy cùng quán'); }
    else if(off[ma]){ nhom='off'; ghi.unshift('OFF hôm này'); }
    else if(ban[ma]){ nhom='ban'; ghi.unshift('đã báo bận'); }
    if(st==='Support') ghi.unshift('người nhà');
    if(st==='Thử việc') ghi.unshift('thử việc');
    out.push({MaNV:String(n.MaNV), Ten:tenNgan(n), ViTri:n.ViTri, Loai:n.Loai, Nhom:nhom, Diem:Math.round(sc*100)/100, LyDo:ghi.join(' · ')});
  });
  var ord={ranh:0,off:1,coCa:2,ban:3};
  out.sort(function(a,b){ return (ord[a.Nhom]-ord[b.Nhom]) || (b.Diem-a.Diem); });
  return {ok:true, list:out};
}


/* ================= HỌC TỪ LỊCH QUẢN LÝ CHỐT =================
   1. Mỗi lần app xếp, bản nháp được lưu (tab LichNhap).
   2. Quản lý sửa xong bấm "Chốt lịch tuần": app lưu bản chốt (LichChot), so với bản nháp → % đoán đúng (DoChinhXac),
      danh sách chỗ sửa (HocLich). Quản lý chọn lý do cho chỗ bỏ người (không bắt buộc).
   3. App học lại: thói quen quán / ca / thứ / giờ từ các tuần đã chốt + chấm công; kinh nghiệm + vị trí thực làm từ chấm công;
      lý do "đi học" → bận cố định; "không hợp quán" / "chưa đủ kinh nghiệm" → không xếp nữa. */
function sheetOf(name, header){ var sh=SS.getSheetByName(name); if(!sh){ sh=SS.insertSheet(name); sh.getRange(1,1,1,header.length).setValues([header]); try{ sh.getRange(1,1,sh.getMaxRows(),header.length).setNumberFormat('@'); }catch(e){} } return sh; }
function ghiTuan(name, header, tuan, newRows){
  var sh=sheetOf(name, header), v=sh.getDataRange().getValues(); v.shift();
  var keep=v.filter(function(r){ return r[0]!=='' && dateKey(r[0])!==tuan; });
  var all=keep.concat(newRows);
  if(sh.getLastRow()>1) sh.getRange(2,1,sh.getLastRow()-1,header.length).clearContent();
  if(all.length) sh.getRange(2,1,all.length,header.length).setValues(all.map(function(r){ return r.map(function(x){ return x===undefined?'':x; }); }));
}
function luuNhap(days, plan){
  ghiTuan('LichNhap',['Tuan','Ngay','MaCS','MaNV','MaCa','ViTri'], days[0], plan.filter(function(a){ return !/Support/.test(a.GhiChu||''); }).map(function(a){ return [days[0],a.Ngay,a.MaCS,String(a.MaNV),a.MaCa,a.ViTri]; }));
}
function weekDays(t){ var d0=mondayOf(t), out=[]; for(var i=0;i<7;i++) out.push(fmtDate(addDays(new Date(d0+'T12:00:00+07:00'),i))); return out; }
function chotLich(p){
  if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'};
  var days=weekDays(p.tuan), d0=days[0];
  var cas={}; rows('Ca').forEach(function(c){ cas[c.MaCa]=c; });
  var byMa={}; rows('NhanVien').forEach(function(n){ byMa[up(n.MaNV)]=n; });
