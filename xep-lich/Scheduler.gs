/* --- đọc chữ trong ô: "Lam (5,5)", "Thư gãy", "Mẫn full", "Linh (8) TC", "Support 1 (support)" --- */
function parseO(t){
  t=String(t||'').replace(/\s+/g,' ').trim(); if(!t) return null;
  var o={gay:/(^|\s)gãy(\s|$)/i.test(t), full:/(^|\s)full(\s|$)/i.test(t), support:/\(support\)/i.test(t), tc:/(^|\s)\+?TC(\s|$)/.test(t)};
  var m=t.match(/\((\d{1,2}(?:[.,]\d)?)\)/); o.hours=m?+m[1].replace(',','.'):null;
  o.name=t.replace(/\(support\)/i,'').replace(/\([^)]*\)/g,' ').replace(/(^|\s)(gãy|full|nvm|QL)(?=\s|$)/gi,' ').replace(/(^|\s)\+?TC(?=\s|$)/g,' ').replace(/\s+/g,' ').trim();
  return o.name?o:null;
}
function normName(s){ return String(s||'').toLowerCase().normalize('NFC').replace(/\s+/g,' ').trim(); }
function findNV(name, cs, list){
  var k=normName(name); if(!k) return null;
  var exact=list.filter(function(n){ return normName(tenNgan(n))===k || String(n.MaNV)===k; });
  var m=k.match(/^(.*)\s(\d{3})$/); if(m){ var byCode=list.filter(function(n){ return String(n.MaNV)===m[2]; }); if(byCode.length) return byCode[0]; }
  if(exact.length===1) return exact[0];
  var c=list.filter(function(n){ var t=String(n.Ten||''), sh=normName(t.split(' (')[0]), inner=(t.match(/\(([^)]*)\)/)||[])[1];
    return sh===k || normName(t)===k || (inner && normName(inner)===k) || String(n.MaNV)===k; });
  if(!c.length) return null; var h=c.filter(function(n){return n.CoSoChinh===cs;}); return h[0]||c[0];
}
function caFromText(o, blk, cs, nv){
  var td=toMin(cs.GioDong)<=1110, h=o.hours, ft=nv && nv.Loai==='FT';
  if(blk==='Sáng'){ if(o.full) return [td?'FT12':'FT11']; if(o.gay && (h===null||h<7)) return ['FT1','PT3']; if(h===null) return [ft?'FT1':'PT1'];
    if(h>=11) return ['FT11']; if(h>=10) return ['FT10']; if(h>=7) return ['FT1']; return ['PT1']; }
  if(blk==='Trưa'){ if(td) return [(h!==null&&h>=7.5)?'FT4':((h!==null&&h<6)?'PT2':'PT4')]; return ['PT2']; }
  if(o.gay) return [(h!==null&&h>=7.5)?'FT2':'PT3']; if(h===null) return [ft?'FT2':'PT3']; return [h>=7.5?'FT2':'PT3'];
}
function posFor(side, nv){
  if(side==='PV') return nv.ViTri==='Bảo vệ'?'Bảo vệ':'Phục vụ';
  if(side==='PC') return nv.ViTri==='Rửa ly'?'Rửa ly':'Pha chế';
  return side==='Quản lý'?'Pha chế':side;    // LĐD: meta là tên vị trí
}

/* Đọc file lịch → ghi đè lịch tuần đó trong LichLam (và ngày OFF) */
function layTuFileLich(p){
  if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'};
  var start=new Date(mondayOf(p.tuan)+'T12:00:00+07:00'), days=[]; for(var i=0;i<7;i++) days.push(fmtDate(addDays(start,i)));
  var f=lichFile(), tag=weekTag(days[0]), csMap={}; rows('CoSo').forEach(function(c){csMap[c.MaCS]=c;});
  var list=rows('NhanVien').filter(function(n){ return n.TrangThai!=='Đã nghỉ'; });
  var out=[], offs=[], loi=[], seen={};
  [['Lịch '+tag,18,1,10],['LĐD '+tag,10,2,null]].forEach(function(cfgS){
    var sh=f.getSheetByName(cfgS[0]); if(!sh){ loi.push('Không có tab "'+cfgS[0]+'" trong file lịch'); return; }
    var v=sh.getDataRange().getValues(), last=null;
    for(var r=0;r<v.length;r++){
      var m=String(v[r][cfgS[1]-1]||'');
      if(m==='' && last){ var anyTxt=v[r].some(function(x,ci){ return ci<cfgS[1]-1 && String(x).trim()!==''; }); if(anyTxt) m=last; }
      if(!m || m.indexOf('WEEK')===0 || m==='GAP' || m==='CONT') { if(m) last=null; continue; }
      if(m==='OFF'){ last=null;
        var cols=cfgS[3]===null?[cfgS[2]]:[cfgS[2],cfgS[3]];
        cols.forEach(function(c0){ for(var di=0;di<7;di++){ String(v[r][c0+di]||'').split('\n').forEach(function(t){ var o=parseO(t); if(!o) return; var nv=findNV(o.name,'',list); if(nv) offs.push([days[0],String(nv.MaNV),days[di]]); else loi.push('OFF: không tìm thấy "'+o.name+'"'); }); } });
        continue; }
      last=m; var parts=m.split('|'), cs=csMap[parts[0]], blk=parts[1], side=parts[2];
      if(!cs) continue;
      var c0s=(cfgS[3]===null)?[cfgS[2]]:[side==='PV'?cfgS[2]:cfgS[3]];
      c0s.forEach(function(c0){ for(var di=0;di<7;di++){
        String(v[r][c0+di]||'').split('\n').forEach(function(t){
          var o=parseO(t); if(!o) return;
          var nv=findNV(o.name, cs.MaCS, list);
          if(!nv){ loi.push(days[di].slice(8,10)+'/'+(+days[di].slice(5,7))+' '+cs.MaCS+' '+blk+': không tìm thấy "'+o.name+'"'); return; }
          var codes=caFromText(o, blk, cs, nv);
          if(blk==='Trưa' && !o.hours && seen[days[di]+'|'+nv.MaNV+'|*']) return;   // tên ở trưa không ghi giờ = người ca sáng làm tiếp
          codes.forEach(function(code,ci){
            var key=days[di]+'|'+nv.MaNV+'|'+code; if(seen[key]) return; seen[key]=1; seen[days[di]+'|'+nv.MaNV+'|*']=1;
            var ghi=o.support?'Support':((o.gay&&(ci>0||blk==='Tối'))?'Ca gãy':(o.tc?'Tăng ca':''));
            out.push([days[di], cs.MaCS, String(nv.MaNV), code, posFor(side,nv), ghi]);
          });
        }); } });
    }
  });
  if(!out.length) return {ok:false, msg:'Không đọc được ca nào từ file lịch tuần này', loi:loi};
  var lock=LockService.getScriptLock(); lock.waitLock(30000);
  try{
    var sh=SS.getSheetByName('LichLam'), all=sh.getDataRange().getValues(), h=all.shift();
    var keep=all.filter(function(r){ return r[0]!=='' && days.indexOf(dateKey(r[0]))<0; });
    var rowsOut=keep.map(function(r){return r.slice(0,6);}).concat(out);
    if(sh.getLastRow()>1) sh.getRange(2,1,sh.getLastRow()-1,Math.max(6,h.length)).clearContent();
    sh.getRange(2,1,rowsOut.length,6).setValues(rowsOut);
    if(offs.length || true){ var nt=SS.getSheetByName('NghiTuan'), nv2=nt.getDataRange().getValues(); nv2.shift();
      var k2=nv2.filter(function(r){ return r[0]!=='' && dateKey(r[0])!==days[0]; }).concat(offs);
      if(nt.getLastRow()>1) nt.getRange(2,1,nt.getLastRow()-1,3).clearContent(); if(k2.length) nt.getRange(2,1,k2.length,3).setValues(k2); }
  } finally { lock.releaseLock(); }
  // cảnh báo trùng giờ
  var cas={}; rows('Ca').forEach(function(c){cas[c.MaCa]=c;}); var byP={};
  out.forEach(function(r){ var k=r[0]+'|'+r[2]; (byP[k]=byP[k]||[]).push(r); });
  Object.keys(byP).forEach(function(k){ var a=byP[k]; for(var i=0;i<a.length;i++) for(var j=i+1;j<a.length;j++){ var x=cas[a[i][3]], y=cas[a[j][3]]; if(x&&y&&toMin(x.GioBD)<toMin(y.GioKT)&&toMin(y.GioBD)<toMin(x.GioKT)){ var n=findNV(a[i][2],'',list); loi.push((n?tenNgan(n):a[i][2])+' bị trùng giờ ngày '+a[i][0].slice(8,10)+'/'+(+a[i][0].slice(5,7))+' ('+a[i][1]+' '+a[i][3]+' và '+a[j][1]+' '+a[j][3]+')'); } } });
  return {ok:true, so:out.length, off:offs.length, loi:loi};
}

/* Xuất lại file lịch từ LichLam (sau khi sửa trên app) */
function xuatFileLich(p){
  if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'};
  var V=viewData(p.tuan);
  writeWeekSheet(V.days, V.stores, V.plan, V.gaps, V.off, V.byMa, V.caMap); writeLddSheet(V.days, V.plan, V.gaps, V.off, V.byMa, V.caMap);
  return {ok:true, url:lichFile().getUrl()};
}
function viewData(tuan){
  var start=new Date(mondayOf(tuan)+'T12:00:00+07:00'), days=[]; for(var i=0;i<7;i++) days.push(fmtDate(addDays(start,i)));
  var caMap={}; rows('Ca').forEach(function(c){ c._blocks=caBlocks(c); caMap[c.MaCa]=c; });
  var byMa={}; rows('NhanVien').forEach(function(n){ byMa[up(n.MaNV)]=n; });
  var plan=rows('LichLam').filter(function(l){ return days.indexOf(dateKey(l.Ngay))>-1 && caMap[l.MaCa]; }).map(function(l){ return {Ngay:dateKey(l.Ngay),MaCS:l.MaCS,MaNV:up(l.MaNV),MaCa:l.MaCa,ViTri:l.ViTri,GhiChu:l.GhiChu||''}; });
  var gaps=[]; if(SS.getSheetByName('GoiY_'+days[0])) rows('GoiY_'+days[0]).forEach(function(g){ gaps.push({Ngay:dateKey(g['Ngày']),MaCS:g['Cơ sở'],Khoi:g['Ca'],ViTri:g['Vị trí'],Thieu:+g['Thiếu']||1,Muc:g['Mức']==='Nên thêm'?'nen':'thieu'}); });
  var off={}; rows('NghiTuan').forEach(function(r){ if(dateKey(r.Tuan)===days[0]) off[up(r.MaNV)]=dateKey(r.Ngay); });
  return {days:days, stores:rows('CoSo'), plan:plan, gaps:gaps, off:off, byMa:byMa, caMap:caMap};
}

/* --- sửa nhanh trên app: đổi tên trong ô / thêm người vào ô --- */
function suaO(p){
  if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'};
  var t=String(p.text||'').trim();
  if(!t && !p.maMoi) return xoaCa({pin:p.pin, ngay:p.ngay, maNV:p.maNV, maCa:p.maCa, maCS:p.maCS});
  var list=rows('NhanVien'), csMap={}; rows('CoSo').forEach(function(c){csMap[c.MaCS]=c;}); var cs=csMap[p.maCS];
  var o, nv;
  if(p.maMoi){ nv=list.filter(function(x){return up(x.MaNV)===up(p.maMoi);})[0]; if(!nv) return {ok:false,msg:'Không tìm thấy mã '+p.maMoi};
    o={name:'', hours:(p.gio===''||p.gio===undefined||p.gio===null)?null:+String(p.gio).replace(',','.'), gay:p.kieu==='gãy', full:p.kieu==='full', tc:!!p.tc, support:nv.TrangThai==='Support'}; }
  else { o=parseO(t); if(!o) return {ok:false,msg:'Không đọc được "'+t+'"'};
    nv=findNV(o.name, p.maCS, list); if(!nv) return {ok:false,msg:'Không tìm thấy nhân viên "'+o.name+'"'}; }
  var cas={}; rows('Ca').forEach(function(c){cas[c.MaCa]=c;}); var oldCa=cas[p.maCa];
  var code=(o.hours!==null||o.full||o.gay)?caFromText(o, oldCa?dispBlock(oldCa):'Sáng', cs, nv)[0]:p.maCa;
  var sh=SS.getSheetByName('LichLam'), v=sh.getDataRange().getValues(), idx=-1;
  for(var i=v.length-1;i>=1;i--){ if(dateKey(v[i][0])===p.ngay && up(v[i][2])===up(p.maNV) && v[i][3]===p.maCa && v[i][1]===p.maCS){ idx=i; break; } }
  if(idx<0) return {ok:false,msg:'Không tìm thấy ca cũ (lịch vừa thay đổi?) – bấm Xem để tải lại'};
  var old=v[idx].slice(0,6); sh.deleteRow(idx+1);
  var chk=checkTrung(nv.MaNV, p.ngay, p.maCS, code);
  if(!chk.ok){ sh.appendRow(old); return chk; }
  var side=(old[4]==='Phục vụ'||old[4]==='Bảo vệ')?'PV':'PC';
  sh.appendRow([p.ngay, p.maCS, String(nv.MaNV), code, posFor(side,nv), o.support?'Support':(o.tc?'Tăng ca':(chk.gay?'Ca gãy – QL sửa':(up(nv.MaNV)===up(p.maNV)?old[5]:'QL đổi người')))]);
  return {ok:true};
}
function themO(p){
  if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'};
  var list=rows('NhanVien'), csMap={}; rows('CoSo').forEach(function(c){csMap[c.MaCS]=c;}); var cs=csMap[p.maCS];
  var o, nv;
  if(p.maMoi){ nv=list.filter(function(x){return up(x.MaNV)===up(p.maMoi);})[0]; if(!nv) return {ok:false,msg:'Không tìm thấy mã '+p.maMoi};
    o={name:'', hours:(p.gio===''||p.gio===undefined||p.gio===null)?null:+String(p.gio).replace(',','.'), gay:p.kieu==='gãy', full:p.kieu==='full', tc:!!p.tc, support:nv.TrangThai==='Support'}; }
  else { o=parseO(p.text); if(!o) return {ok:false,msg:'Chưa nhập tên'};
    nv=findNV(o.name, p.maCS, list); if(!nv) return {ok:false,msg:'Không tìm thấy nhân viên "'+o.name+'"'}; }
