/* ================= LỊCH THỰC TẾ TỪ CHẤM CÔNG =================
   Ghép giờ vào – ra trong chấm công thành lịch làm thật (quán, ca gần nhất, vị trí thực làm). App học từ lịch này (đúng hơn lịch dự kiến). */
var _OD=null;
function onDinh(ma){ if(_OD===null){ _OD={}; Object.keys(ON_DINH).forEach(function(k){ _OD[k]=ON_DINH[k]; }); if(SS.getSheetByName('OnDinh')) rows('OnDinh').forEach(function(r){ _OD[up(r.MaNV)]=+r.ChiSo; }); }
  var v=_OD[up(ma)]; return (v===undefined||v===null||isNaN(v))?null:v; }
function dungLichThucTe(p){
  if(p && p.pin && !authRole(p.pin)) return {ok:false,msg:'Sai mã'};
  if(cfg('CHAM_CONG_SHEET_ID')){ var dbx=dongBoChamCong(); return {ok:!!dbx.ok, so:dbx.caThucTe||0, tuan:mondayOf(p.tuan), tuApp:'Chấm công'}; }   // đã tách app: lấy từ app Chấm công
  var days=weekDays(p.tuan), d0=days[0], cas=rows('Ca');
  var cc=rows('ChamCong').filter(function(r){ return days.indexOf(dateKey(r.Ngay))>-1; }).sort(function(a,b){ return new Date(a.ThoiGian)-new Date(b.ThoiGian); });
  var mo={}, out=[];
  var phut=function(t){ var d=new Date(t); return +fmtTZ_(d,TZ,'HH')*60 + +fmtTZ_(d,TZ,'mm'); };
  var gan=function(vao,ra,csMa){ var best=null,bs=1e9; cas.forEach(function(c){ var cs=String(c.CoSo||'ALL'); if(cs!=='ALL' && cs.split(',').map(function(x){return x.trim();}).indexOf(csMa)<0) return;
      var dv=Math.abs(toMin(c.GioBD)-vao)+Math.abs(toMin(c.GioKT)-ra); if(dv<bs){ bs=dv; best=c; } }); return best; };
  cc.forEach(function(r){ var m=up(r.MaNV);
    if(r.Loai==='VAO'){ mo[m]=r; return; }
    if(r.Loai==='RA' && mo[m]){ var v=mo[m]; mo[m]=null; var c=(v.MaCa && cas.filter(function(x){return x.MaCa===v.MaCa;})[0]) || gan(phut(v.ThoiGian),phut(r.ThoiGian),v.MaCS);
      var vao=phut(v.ThoiGian), ra=phut(r.ThoiGian); if(!v.MaCa || Math.abs(toMin(c.GioBD)-vao)>60 || Math.abs(toMin(c.GioKT)-ra)>90) c=gan(vao,ra,v.MaCS)||c;
      out.push([d0, dateKey(v.Ngay), v.MaCS, m, c?c.MaCa:'', String(v.ViTriLam||''), fmtTime(new Date(v.ThoiGian)), fmtTime(new Date(r.ThoiGian))]); } });
  ghiTuan('LichThucTe',['Tuan','Ngay','MaCS','MaNV','MaCa','ViTri','Vao','Ra'], d0, out);
  // cập nhật chỉ số ổn định từ các tuần thực tế
  try{ capNhatOnDinh(); }catch(e){}
  return {ok:true, so:out.length, tuan:d0};
}
function capNhatOnDinh(){
  if(!SS.getSheetByName('LichThucTe')) return; var cas={}; rows('Ca').forEach(function(c){ cas[c.MaCa]=c; });
  var W={}; rows('LichThucTe').forEach(function(r){ var c=cas[r.MaCa]; if(!c) return; var m=up(r.MaNV), t=dateKey(r.Tuan); W[m]=W[m]||{}; W[m][t]=W[m][t]||{}; W[m][t][dowOf(dateKey(r.Ngay))+'|'+dispBlock(c)]=1; });
  var out=[]; Object.keys(W).forEach(function(m){ var ks=Object.keys(W[m]).sort(), sims=[];
    for(var i=1;i<ks.length;i++){ var A=W[m][ks[i-1]], B=W[m][ks[i]], u={}, n=0; Object.keys(A).concat(Object.keys(B)).forEach(function(k){u[k]=1;}); Object.keys(A).forEach(function(k){ if(B[k]) n++; }); var uu=Object.keys(u).length; if(uu) sims.push(n/uu); }
    if(sims.length>=2){ var moi=sims.reduce(function(a,b){return a+b;},0)/sims.length, cu=ON_DINH[m]; out.push([m, Math.round(((cu===undefined?moi:(cu*0.5+moi*0.5)))*100)/100, sims.length]); } });
  var sh=sheetOf('OnDinh',['MaNV','ChiSo','SoTuan']); if(sh.getLastRow()>1) sh.getRange(2,1,sh.getLastRow()-1,3).clearContent(); if(out.length) sh.getRange(2,1,out.length,3).setValues(out); _OD=null;
}


/* ================= NỐI VỚI APP CHẤM CÔNG (chỉ ĐỌC) =================
   App Chấm công giữ danh sách nhân viên gốc và giờ làm thật. App Xếp lịch đọc về để xếp và học,
   không ghi gì sang bên đó. CaiDat CHAM_CONG_SHEET_ID = ID Google Sheet của app Chấm công. */
var _CCLOI='';
function ccSheet(){ var id=String(cfg('CHAM_CONG_SHEET_ID')||'').replace(/[\s\u200B-\u200D\uFEFF]/g,''); if(!id){ _CCLOI='chưa điền CHAM_CONG_SHEET_ID trong tab CaiDat'; return null; }
  try{ return SpreadsheetApp.openById(id); }catch(e){ _CCLOI=e.message; return null; } }
// Chạy trong trình soạn Apps Script (chọn hàm này → Chạy) để xem vì sao chưa nối được app Chấm công; kết quả ở Nhật ký thực thi
function kiemTraNoiChamCong(){ var id=String(cfg('CHAM_CONG_SHEET_ID')||''), sach=id.replace(/[\s\u200B-\u200D\uFEFF]/g,'');
  try{ Logger.log('Tài khoản đang chạy app: '+Session.getEffectiveUser().getEmail()); }catch(e){}
  Logger.log('CHAM_CONG_SHEET_ID đọc được: ['+id+'] – '+id.length+' ký tự (đúng là 44)'+(sach!==id?' – có ký tự thừa, đã tự bỏ':''));
  Logger.log('CHAM_CONG_URL đọc được: ['+cfg('CHAM_CONG_URL')+']');
  try{ var ss=SpreadsheetApp.openById(sach), nv=ss.getSheetByName('NhanVien'); Logger.log('MỞ ĐƯỢC Sheet: '+ss.getName()+' – nhân viên: '+(nv?nv.getLastRow()-1:'không có tab NhanVien')); }
  catch(e){ Logger.log('KHÔNG MỞ ĐƯỢC: '+e.message); } }
function ccRowsTu(ss, ten){ var sh=ss.getSheetByName(ten); if(!sh) return []; var v=sh.getDataRange().getValues(), h=v.shift();
  return v.filter(function(r){ return r.join('')!==''; }).map(function(r){ var o={}; h.forEach(function(k,j){ o[k]=r[j]; }); return o; }); }
function dongBoChamCong(p){
  if(p && p.pin && !authRole(p.pin)) return {ok:false,msg:'Sai mã'};
  var ss=ccSheet(); if(!ss) return {ok:false,msg:'Chưa nối được app Chấm công: '+_CCLOI};
  // 1. nhân viên: hồ sơ DUY NHẤT ở app Chấm công (kể cả vị trí kiêm, tăng ca được, cố định, sinh viên)
  var ns=nhanSuTuCC_(ss), them=ns.them, sua=ns.sua;
  // 2. lịch thực tế: mỗi ca đã ra (đúng giờ đã xác nhận) → tab LichThucTe theo tuần
  var cc=ccRowsTu(ss,'ChamCong').filter(function(r){ return r.Ra!=='' && r.Ra!==undefined && String(r.TrangThai||'')!=='Đang làm'; });
  var hh=function(x){ if(x instanceof Date) return fmtTZ_(x,TZ,'HH:mm'); var m=String(x||'').match(/(\d{1,2}):(\d{2})/); return m?(('0'+m[1]).slice(-2)+':'+m[2]):''; };
  var byTuan={}; cc.forEach(function(r){ var d=dateKey(r.Ngay), t=mondayOf(d); (byTuan[t]=byTuan[t]||[]).push([t,d,r.MaCS,up(r.MaNV),r.MaCa,String(r.ViTri||''),hh(r.Vao),hh(r.Ra)]); });
  // tuần có ngày đã được app Chấm công lưu trữ (tách sang file riêng): giữ lại các ngày đó ở đây để không mất dữ liệu học
  var coNgay={}; Object.keys(byTuan).forEach(function(t){ byTuan[t].forEach(function(r){ coNgay[r[1]]=1; }); });
  var cuTT=SS.getSheetByName('LichThucTe')?rows('LichThucTe'):[];
  Object.keys(byTuan).forEach(function(t){ var giu=cuTT.filter(function(r){ return dateKey(r.Tuan)===t && !coNgay[dateKey(r.Ngay)]; }).map(function(r){ return [t, dateKey(r.Ngay), r.MaCS, up(r.MaNV), r.MaCa, String(r.ViTri||''), hh(r.Vao), hh(r.Ra)]; });
    ghiTuan('LichThucTe',['Tuan','Ngay','MaCS','MaNV','MaCa','ViTri','Vao','Ra'], t, giu.concat(byTuan[t])); });
  try{ capNhatOnDinh(); }catch(e){}
  // 3. khảo sát (nằm ở app Chấm công): lấy câu trả lời mới nhất mỗi người → dữ liệu xếp lịch; kỹ năng đã xác nhận → vị trí kiêm, tăng ca
  var soKS=0; try{ soKS=dongBoKhaoSat(ss); }catch(e){}
  try{ dongBoDangKy(ss); }catch(e){}
  setCfg('DONG_BO_LUC', fmtTZ_(new Date(),TZ,'dd/MM HH:mm'));
  return {ok:true, nhanVienMoi:them, nhanVienSua:sua, caThucTe:cc.length, tuan:Object.keys(byTuan).length, khaoSat:soKS};
}

function dongBoKhaoSat(ss){
  var ks=ccRowsTu(ss,'KhaoSat'); if(!ks.length) return 0;
  var moiNhat={}; ks.forEach(function(r){ var m=up(r.MaNV); if(m) moiNhat[m]=r; });
  var nvCC={}; ccRowsTu(ss,'NhanVien').forEach(function(n){ nvCC[up(n.MaNV)]=n; });
  var sh=sheetOf('KhaoSat',['MaNV','NgayGui','DuLieu','XacNhan','NgayXacNhan']); if(sh.getLastRow()>1) sh.getRange(2,1,sh.getLastRow()-1,5).clearContent();
  var out=[], TK=['T2','T3','T4','T5','T6','T7','CN'], KH=['Sáng','Trưa','Tối'];
  var bcd=sheetOf('BanCoDinh',['MaNV','Thu','Khoi','Nguon']), bv=bcd.getDataRange().getValues(), giu=[bv[0]];
  for(var j=1;j<bv.length;j++){ if(!(moiNhat[up(bv[j][0])] && /^Khảo sát/.test(String(bv[j][3]||'')))) giu.push(bv[j]); }
  Object.keys(moiNhat).forEach(function(m){ var r=moiNhat[m], d={}; try{ d=JSON.parse(r.DuLieu||'{}'); }catch(e){}
    if(d.ngayVao && !d.batDau) d.batDau=String(d.ngayVao).slice(0,7);
    var xn=String(r.KyNang||'')==='Đã xác nhận'?'Đã xác nhận':''; out.push([m, r.NgayGui, JSON.stringify(d), xn, '']);
    var ranh=d.ranh||{}; if(Object.keys(ranh).some(function(k){ return ranh[k]; })) TK.forEach(function(t){ KH.forEach(function(kh){ if(!ranh[t+'|'+kh]) giu.push([m,t,kh,'Khảo sát: không rảnh']); }); });
    if(d.nghiThu && TK.indexOf(d.nghiThu)>-1) giu.push([m,d.nghiThu,'Cả ngày','Khảo sát: ngày nghỉ']);
    // kỹ năng admin đã xác nhận bên app Chấm công
    if(xn && nvCC[m]){ var nsh=SS.getSheetByName('NhanVien'), nv=nsh.getDataRange().getValues(), h=nv[0];
      for(var i=1;i<nv.length;i++) if(up(nv[i][h.indexOf('MaNV')])===m){ if(h.indexOf('ViTriKiem')>-1) nsh.getRange(i+1,h.indexOf('ViTriKiem')+1).setValue(String(nvCC[m].ViTriKiem||'')); if(h.indexOf('TangCaDuoc')>-1 && nvCC[m].TangCaDuoc) nsh.getRange(i+1,h.indexOf('TangCaDuoc')+1).setValue(nvCC[m].TangCaDuoc); break; } } });
  if(out.length) sh.getRange(2,1,out.length,5).setValues(out);
  if(bcd.getLastRow()>0) bcd.getRange(1,1,bcd.getLastRow(),4).clearContent(); bcd.getRange(1,1,giu.length,4).setValues(giu.map(function(x){ return [x[0],x[1],x[2],x[3]]; }));
  _TN=null; return out.length; }


/* ================= CA CẦN NGƯỜI (quản lý đăng, nhân viên nhận ở app Chấm công) ================= */
function ccnSheet(){ return sheetOf('CaCanNguoi',['ID','Ngay','MaCS','GioBD','GioKT','ViTri','SoNguoi','GhiChu','TrangThai','DaChon','Luc']); }
function dangCaCanNguoi(p){ if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'}; var bd=fmtCa(p.gioBD), kt=fmtCa(p.gioKT);
  if(!p.ngay || !p.maCS) return {ok:false,msg:'Chọn ngày và quán'}; if(!/^\d{2}:\d{2}$/.test(bd)||!/^\d{2}:\d{2}$/.test(kt)||toMin(kt)<=toMin(bd)) return {ok:false,msg:'Giờ kết thúc phải sau giờ bắt đầu'};
  var id='C'+fmtTZ_(new Date(),TZ,'yyMMddHHmmss')+Math.floor(Math.random()*1e4);
  ccnSheet().appendRow([id, p.ngay, p.maCS, bd, kt, p.viTri||'Phục vụ', Math.max(1,+p.soNguoi||1), String(p.ghiChu||''), 'Mở', '', new Date()]); return {ok:true, id:id}; }
function dsCaCanNguoi(p){ if(!authRole(p.pin)) return {ok:false,msg:'Sai mã'}; var today=fmtDate(new Date()), ss=ccSheet();
  var nhan=ss?ccRowsTu(ss,'NhanCa'):[], ranh=ss?ccRowsTu(ss,'RanhThem'):[], nv={}; rows('NhanVien').forEach(function(n){ nv[up(n.MaNV)]=n; });
  var ks={}; (SS.getSheetByName('KhaoSat')?rows('KhaoSat'):[]).forEach(function(r){ try{ var d=JSON.parse(r.DuLieu||'{}'); if(d.lamThay==='Thường được') ks[up(r.MaNV)]=1; }catch(e){} });
  var ten=function(m){ var n=nv[up(m)]; return n?tenNgan(n):m; };
  var LL=rows('LichLam'), CM={}; rows('Ca').forEach(function(c){ CM[c.MaCa]=c; });
  var daCo=function(m,ngay,bd,kt){ var L=LL.filter(function(l){ return dateKey(l.Ngay)===ngay && up(l.MaNV)===up(m) && CM[l.MaCa]; }); if(!L.length) return {txt:'',kin:false};
    var trung=L.some(function(l){ return toMin(fmtCa(CM[l.MaCa].GioBD))<toMin(kt) && toMin(fmtCa(CM[l.MaCa].GioKT))>toMin(bd); });
    return {txt:'đã có ca '+L.map(function(l){ return l.MaCS+' '+fmtCa(CM[l.MaCa].GioBD)+'–'+fmtCa(CM[l.MaCa].GioKT); }).join(', '), kin:trung||L.length>=2}; };
  var list=(SS.getSheetByName('CaCanNguoi')?rows('CaCanNguoi'):[]).filter(function(c){ return dateKey(c.Ngay)>=(p.tu||today) && String(c.TrangThai)!=='Huỷ'; }).map(function(c){ var id=String(c.ID), ngay=dateKey(c.Ngay), bd=fmtCa(c.GioBD), kt=fmtCa(c.GioKT), chon=String(c.DaChon||'').split(',').filter(Boolean);
    var nhanDs=nhan.filter(function(x){ return String(x.CaID)===id; }).map(function(x){ var dc=daCo(x.MaNV,ngay,bd,kt); return {MaNV:String(x.MaNV), Ten:ten(x.MaNV), Ban:banLuc(x.MaNV,ngay,bd,kt), Lich:dc.txt, Kin:dc.kin, DaChon:chon.indexOf(String(x.MaNV))>-1}; });
    var co={}; nhanDs.forEach(function(x){ co[up(x.MaNV)]=1; });
    var goiY=ranh.filter(function(r){ return dateKey(r.Ngay)===ngay && toMin(fmtCa(r.Tu))<=toMin(bd) && toMin(fmtCa(r.Den))>=toMin(kt) && !co[up(r.MaNV)] && !daCo(r.MaNV,ngay,bd,kt).kin; }).map(function(r){ return {MaNV:String(r.MaNV), Ten:ten(r.MaNV), Ly:'báo rảnh '+fmtCa(r.Tu)+'–'+fmtCa(r.Den)}; });
    Object.keys(ks).forEach(function(m){ if(co[m] || goiY.some(function(g){ return up(g.MaNV)===m; }) || !nv[m] || ['Đã nghỉ','Nghỉ việc'].indexOf(String(nv[m].TrangThai||''))>-1) return; if(banLuc(m,ngay,bd,kt)) return;
      if(LL.some(function(l){ return dateKey(l.Ngay)===ngay && up(l.MaNV)===m; })) return; goiY.push({MaNV:m, Ten:ten(m), Ly:'khảo sát: thường làm thay được'}); });
    return {ID:id, Ngay:ngay, MaCS:c.MaCS, GioBD:bd, GioKT:kt, ViTri:c.ViTri, SoNguoi:+c.SoNguoi||1, GhiChu:c.GhiChu, TrangThai:String(c.TrangThai||'Mở'), DaChon:chon.map(function(m){ return {MaNV:m,Ten:ten(m)}; }), Nhan:nhanDs, GoiY:goiY.slice(0,8)}; })
    .sort(function(a,b){ return (a.Ngay+a.GioBD)<(b.Ngay+b.GioBD)?-1:1; });
  var ranhSap=ranh.filter(function(r){ return dateKey(r.Ngay)>=today; }).map(function(r){ return {Ngay:dateKey(r.Ngay), MaNV:String(r.MaNV), Ten:ten(r.MaNV), Tu:fmtCa(r.Tu), Den:fmtCa(r.Den), GhiChu:r.GhiChu}; }).sort(function(a,b){ return (a.Ngay+a.Tu)<(b.Ngay+b.Tu)?-1:1; });
  var link=String(cfg('CHAM_CONG_URL')||''); return {ok:true, list:list, ranh:ranhSap, linkNV:link}; }

