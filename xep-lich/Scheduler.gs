// Ca giờ tự do: mã TDhhmm-hhmm, tự thêm vào danh sách ca để mọi phần xếp lịch dùng được; app Chấm công đọc giờ từ chính mã này
function caTuDoTao(bd, kt){ var a=fmtCa(bd), b=fmtCa(kt); if(!/^\d{2}:\d{2}$/.test(a)||!/^\d{2}:\d{2}$/.test(b)||toMin(b)<=toMin(a)) return {ok:false,msg:'Giờ kết thúc phải sau giờ bắt đầu'};
