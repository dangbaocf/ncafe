}

/* Bảng theo nhân viên: hàng = người, cột = ngày, ô = quán · ca · giờ · vị trí. Màu: đã xếp theo quán, tím = gãy/tăng ca/lấp thiếu,
   cam = OFF, hồng = đăng ký bận, vàng = chưa xếp nhưng có gợi ý, xám = chưa xếp và chưa gợi ý */
var MAU={xep:null, them:'#E3D7F5', off:'#FFD8A8', ban:'#F8C9C9', goiy:'#FFF3B0', trong:'#C8C8C8'};
function writePersonGrid(days, nvs, plan, off, ban, goiY, caMap, csMap, S){
  var name='NV_'+days[0], sh=SS.getSheetByName(name); if(sh) sh.clear(); else sh=SS.insertSheet(name);
  var DN=['CN','T2','T3','T4','T5','T6','T7'];
  var sug={}; goiY.forEach(function(g){ g.GoiY.forEach(function(x){ var k=x.MaNV+'|'+g.Ngay; (sug[k]=sug[k]||[]).push(g.MaCS+' '+g.Khoi+' '+g.ViTri); }); });
  var order=['Quản lý','Pha chế','Thu ngân','Phục vụ','Rửa ly','Bảo vệ'];
  var list=nvs.slice().sort(function(a,b){ return (order.indexOf(a.ViTri)-order.indexOf(b.ViTri)) || String(a.CoSoChinh).localeCompare(String(b.CoSoChinh)) || String(a.MaNV).localeCompare(String(b.MaNV)); });
  var out=[['Mã','Tên','Vị trí','Quán chính','Giờ tuần'].concat(days.map(function(d){return DN[dowOf(d)]+' '+d.slice(8,10)+'/'+(+d.slice(5,7));}))], bg=[[null,null,null,null,null].concat(days.map(function(){return '#F3ECE3';}))];
  list.forEach(function(n){
    var r=[String(n.MaNV), tenNgan(n), n.ViTri, n.CoSoChinh, Math.round((S[n._ma]?S[n._ma].hours:0)*10)/10], b=[null,null,null,null,null];
    days.forEach(function(d){
      var mine=plan.filter(function(a){return a.MaNV===n._ma && a.Ngay===d;});
      var bans=ban.filter(function(x){return up(x.MaNV)===n._ma && dateKey(x.Ngay)===d;}).map(function(x){return x.Khoi;});
      if(mine.length){
        r.push(mine.map(function(a){ var c=caMap[a.MaCa]; return a.MaCS+' · '+(c?fmtCa(c.GioBD)+'–'+fmtCa(c.GioKT)+' ('+String(c.SoGio).replace('.',',')+'h)':a.MaCa)+' · '+a.ViTri+(a.GhiChu&&/gãy|Tăng ca|Lấp thiếu/.test(a.GhiChu)?' · '+a.GhiChu:''); }).join('\n'));
        var them=mine.length>1 || mine.some(function(a){return /gãy|Tăng ca|Lấp thiếu/.test(a.GhiChu||'');});
        b.push(them?MAU.them:(STORE_COLOR[mine[0].MaCS]||'#FFFFFF'));
      } else if(off[n._ma]===d){ r.push('OFF'); b.push(MAU.off); }
      else if(bans.length){ r.push('Bận '+bans.join(', ')); b.push(MAU.ban); }
      else if(sug[n._ma+'|'+d]){ r.push('Chưa xếp – gợi ý: '+sug[n._ma+'|'+d].join('; ')); b.push(MAU.goiy); }
      else { r.push('Trống'); b.push(MAU.trong); }
    });
    out.push(r); bg.push(b);
  });
  out.push(['']); bg.push([null]);
  out.push(['Chú thích: màu quán = đã xếp · tím = gãy / tăng ca / lấp thiếu · cam = OFF · hồng = đăng ký bận · vàng = chưa xếp, có gợi ý · xám đậm = chưa xếp, chưa gợi ý (TP = trắng)']); bg.push([null]);
  var w=out[0].length; out=out.map(function(r){ while(r.length<w) r.push(''); return r; }); bg=bg.map(function(r){ while(r.length<w) r.push(null); return r; });
  sh.getRange(1,1,out.length,w).setValues(out).setBackgrounds(bg).setFontFamily('Arial').setWrap(true).setVerticalAlignment('top');
  sh.getRange(1,1,1,w).setFontWeight('bold');
  for(var i=6;i<=w;i++) sh.setColumnWidth(i,170);
  sh.setFrozenRows(1); sh.setFrozenColumns(2);
  return name;
}

/* Kiểm tra trùng: người đã có ca trong ngày chỉ được thêm ca gãy cùng quán (không trùng giờ) hoặc kéo dài ca */
function checkTrung(maNV, ngay, maCS, maCa){
  var cas={}; rows('Ca').forEach(function(c){cas[c.MaCa]=c;}); var c=cas[maCa];
  var mine=rows('LichLam').filter(function(l){ return dateKey(l.Ngay)===ngay && up(l.MaNV)===up(maNV); });
  if(!mine.length) return {ok:true, gay:false};
  var nv=rows('NhanVien').filter(function(n){return up(n.MaNV)===up(maNV);})[0];
  var ten=nv?tenNgan(nv):maNV;
  var desc=mine.map(function(l){ var x=cas[l.MaCa]; return l.MaCS+' '+(x?fmtCa(x.GioBD)+'–'+fmtCa(x.GioKT):l.MaCa); }).join(', ');
  if(mine.length>1) return {ok:false,msg:ten+' đã được xếp '+desc+' ngày này (đã gãy), không xếp thêm.'};
  var a=mine[0], x=cas[a.MaCa];
  if(a.MaCS!==maCS && String(cfg('HAI_QUAN_1_NGAY')||'Có')==='Không') return {ok:false,msg:ten+' đã được xếp '+desc+' ngày này. Chỉ thêm được ca gãy cùng quán hoặc kéo dài ca.'};
  if(x && c && toMin(c.GioBD)<toMin(x.GioKT) && toMin(x.GioBD)<toMin(c.GioKT)) return {ok:false,msg:ten+' đã có ca trùng giờ ('+desc+').'};
  var gayChiFT=String(cfg('GAY_CHI_FT')||'LDD').split(',').map(function(z){return z.trim();});
  if(nv && nv.Loai!=='FT' && (gayChiFT.indexOf(maCS)>-1 || gayChiFT.indexOf(a.MaCS)>-1)) return {ok:false,msg:ten+' là part time, ở '+(gayChiFT.indexOf(maCS)>-1?maCS:a.MaCS)+' chỉ FT được làm gãy.'};
  if(nv && a.MaCS!==maCS && (nv.CoDinh==='Có' || nv.ViTri==='Bảo vệ')) return {ok:false,msg:ten+' cố định ở '+a.MaCS+', không làm quán khác.'};
  return {ok:true, gay:true};
}

